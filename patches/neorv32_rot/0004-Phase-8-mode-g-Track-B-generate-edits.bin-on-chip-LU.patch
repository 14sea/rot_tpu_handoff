new file mode 100644
index 0000000..f639bcf
--- /dev/null
+++ b/sw/stage2_loader/crc32_iso.c
@@ -0,0 +1,32 @@
+/* crc32_iso.c — see crc32_iso.h.
+ *
+ * Bit-serial implementation chosen for code size over speed: ~50 B of
+ * machine code, no 1-KB table.  At ~50 MHz the chip processes the
+ * 9492-byte stage2 upload in ~1 ms and a 32-KB edits.bin in ~3 ms —
+ * the table-driven variant would only save sub-millisecond and is
+ * not worth the .rodata.
+ */
+#include "crc32_iso.h"
+
+uint32_t crc32_update(uint32_t crc, const uint8_t *data, uint32_t len)
+{
+    for (uint32_t i = 0; i < len; i++) {
+        crc ^= data[i];
+        for (int j = 0; j < 8; j++)
+            crc = (crc >> 1) ^ (0xEDB88320u & -(crc & 1u));
+    }
+    return crc;
+}
+
+uint32_t crc32(const uint8_t *data, uint32_t len)
+{
+    return ~crc32_update(0xFFFFFFFFu, data, len);
+}
+
+uint32_t crc32_two(const uint8_t *p1, uint32_t n1,
+                   const uint8_t *p2, uint32_t n2)
+{
+    uint32_t crc = crc32_update(0xFFFFFFFFu, p1, n1);
+    crc = crc32_update(crc, p2, n2);
+    return ~crc;
+}
