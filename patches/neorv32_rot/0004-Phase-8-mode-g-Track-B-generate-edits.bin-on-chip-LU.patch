new file mode 100644
index 0000000..aac851c
--- /dev/null
+++ b/host/test_edits_bin.py
@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""
+test_edits_bin.py — Phase 8 edits.bin round-trip + cross-CRC gate.
+
+Validates that:
+
+  1. gen_edits.pack_edits + gen_edits.parse_edits round-trip byte-for-byte.
+  2. The CRC-32/ISO-HDLC computed by the on-chip C routine
+     (sw/stage2_loader/crc32_iso.c, the exact code stage2 runs in mode_g)
+     matches the host-side Python CRC.  Compiled via gcc → ctypes, so a
+     drift between the two implementations would be caught here at CI
+     time rather than after a Quartus rebuild + JTAG reflash.
+  3. Negative cases mode_g advertises in plan §Phase 8 (bad magic, bad
+     version, CRC bit-flip, truncation) all fail parse_edits.
+  4. The whitelist enforcement in gen_edits matches the on-chip lc_init
+     whitelist (PIN_X × LAB_Y_CE6 × even-N).
+
+The CRC cross-check is the load-bearing piece — Phase 8's integrity gate
+depends on host and chip computing the same value.  Random divergence
+would silently corrupt the trust boundary documented in the plan.
+
+Run:
+  python3 host/test_edits_bin.py
+"""
+import binascii
+import ctypes
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(REPO, "host"))
+import gen_edits  # noqa: E402
+
+
+def build_crc_so(workdir):
+    src = os.path.join(REPO, "sw", "stage2_loader", "crc32_iso.c")
+    so_path = os.path.join(workdir, "crc32_iso.so")
+    subprocess.run(
+        ["gcc", "-O2", "-fPIC", "-shared", "-Wall",
+         "-I", os.path.dirname(src), src, "-o", so_path],
+        check=True,
+    )
+    lib = ctypes.CDLL(so_path)
+    lib.crc32.argtypes = [ctypes.POINTER(ctypes.c_uint8), ctypes.c_uint32]
+    lib.crc32.restype = ctypes.c_uint32
+    lib.crc32_two.argtypes = [
+        ctypes.POINTER(ctypes.c_uint8), ctypes.c_uint32,
+        ctypes.POINTER(ctypes.c_uint8), ctypes.c_uint32,
+    ]
+    lib.crc32_two.restype = ctypes.c_uint32
+    return lib
+
+
+def _to_carr(b):
+    return (ctypes.c_uint8 * len(b)).from_buffer_copy(b)
+
+
+def test_round_trip():
+    """pack_edits → parse_edits must yield identical records."""
+    records = [
+        (10,  2, 0, 0x0000),
+        (10,  2, 0, 0xFFFF),
+        (16,  4, 6, 0xABCD),
+        (22, 10, 16, 0x1234),
+        (28, 21, 30, 0xCAFE),
+    ]
+    blob = gen_edits.pack_edits(records)
+    parsed = gen_edits.parse_edits(blob)
+    assert parsed == records, f"round-trip mismatch: {parsed!r} != {records!r}"
+    return len(records)
+
+
+def test_crc_cross(crc_lib):
+    """For the same payload bytes, the on-chip C CRC must equal binascii.crc32.
+
+    Exercises both crc32() (contiguous) and crc32_two() (two-range form,
+    which is what mode_g actually calls on edits.bin)."""
+    failures = []
+
+    # Contiguous form — sanity check that the algorithm matches at all.
+    for payload in [b"", b"A", b"123456789",  # standard test vector
+                    b"\x00" * 1000,
+                    bytes(range(256)) * 3]:
+        py_crc = binascii.crc32(payload) & 0xFFFFFFFF
+        c_crc = crc_lib.crc32(_to_carr(payload), len(payload)) \
+            if payload else crc_lib.crc32(None, 0)
+        if c_crc != py_crc:
+            failures.append(
+                f"crc32(len={len(payload)}): C=0x{c_crc:08x} "
+                f"Py=0x{py_crc:08x}")
+
+    # Standard ISO-HDLC vector — "123456789" → 0xCBF43926.
+    golden = crc_lib.crc32(_to_carr(b"123456789"), 9)
+    if golden != 0xCBF43926:
+        failures.append(
+            f"crc32('123456789') = 0x{golden:08x} != 0xCBF43926 "
+            f"(IEEE 802.3 reference)")
+
+    # Two-range form — this is what mode_g runs on edits.bin.
+    # Concat-equivalence: crc32_two(p1, p2) == crc32(p1||p2).
+    for p1, p2 in [(b"hello", b"world"),
+                   (b"\x04\x00\x00\x00\x02\x00\x00\x00",  # ver=4, n=2
+                    b"\x0a\x00\x02\x00\x00\x00\xcd\xab" * 2),
+                   (b"", b"asymmetric"),
+                   (b"asymmetric", b"")]:
+        py_crc = binascii.crc32(p1 + p2) & 0xFFFFFFFF
+        c_crc = crc_lib.crc32_two(
+            _to_carr(p1) if p1 else None, len(p1),
+            _to_carr(p2) if p2 else None, len(p2),
+        )
+        if c_crc != py_crc:
+            failures.append(
+                f"crc32_two(|{len(p1)}|, |{len(p2)}|): "
+                f"C=0x{c_crc:08x} Py=0x{py_crc:08x}")
+
+    return failures
+
+
+def test_edits_crc_matches_chip(crc_lib):
+    """For a real edits.bin, the on-chip mode_g CRC path
+    (crc32_two over [version|n_records] ∪ [records]) must match the
+    on-disk crc32 field (which gen_edits set via binascii.crc32)."""
+    records = [(10, 4, 0, 0xABCD), (16, 8, 14, 0x5A5A), (22, 11, 28, 0x1234)]
+    blob = gen_edits.pack_edits(records)
+    # Header fields
+    _magic, _ver, n_rec, on_disk_crc = struct.unpack("<IIII", blob[:16])
+    # mode_g recomputes CRC over [version|n_records] then [records].
+    p1 = blob[4:12]                     # version + n_records
+    p2 = blob[16:16 + n_rec * 8]        # records body
+    chip_crc = crc_lib.crc32_two(
+        _to_carr(p1), len(p1),
+        _to_carr(p2), len(p2),
+    )
+    assert chip_crc == on_disk_crc, (
+        f"chip_crc=0x{chip_crc:08x} != on_disk=0x{on_disk_crc:08x} "
+        f"— mode_g would refuse a freshly-generated edits.bin")
+
+
+def test_negative():
+    """Each tampering mode_g advertises in plan §Phase 8 fails parse_edits."""
+    base_records = [(10, 4, 0, 0xABCD), (16, 8, 14, 0x5A5A)]
+    blob = bytearray(gen_edits.pack_edits(base_records))
+    failures = []
+
+    def expect_fail(name, mutated, needle):
+        try:
+            gen_edits.parse_edits(bytes(mutated))
+            failures.append(f"{name}: parse_edits unexpectedly succeeded")
+        except ValueError as e:
+            if needle not in str(e):
+                failures.append(
+                    f"{name}: wrong error message: {e!r} (want '{needle}')")
+
+    bad_magic = bytearray(blob); bad_magic[0] ^= 0x10
+    expect_fail("bad-magic", bad_magic, "bad magic")
+
+    bad_ver = bytearray(blob); bad_ver[4] = 99
+    expect_fail("bad-version", bad_ver, "unsupported version")
+
+    bad_crc = bytearray(blob); bad_crc[20] ^= 0x01  # flip a record byte
+    expect_fail("crc-flip", bad_crc, "CRC32 mismatch")
+
+    short = bytearray(blob[:24])  # claims 2 records, has only 1
+    expect_fail("truncated", short, "truncated")
+
+    too_short = bytearray(blob[:10])
+    expect_fail("under-header", too_short, "too short")
+
+    return failures
+
+
+def test_whitelist():
+    """Out-of-whitelist tuples are rejected before pack."""
+    bad = [
+        ((5, 4, 0, 0), "pin-friendly whitelist"),
+        ((10, 1, 0, 0), "LAB_Y_CE6"),
+        ((10, 15, 0, 0), "LAB_Y_CE6"),  # gap in Y range
+        ((10, 4, 1, 0), "even-N"),
+        ((10, 4, 32, 0), "even-N"),
+    ]
+    failures = []
+    for tup, needle in bad:
+        try:
+            gen_edits.pack_edits([tup])
+            failures.append(f"whitelist: {tup} unexpectedly accepted")
+        except ValueError as e:
+            if needle not in str(e):
+                failures.append(
+                    f"whitelist {tup}: wrong msg: {e!r} (want '{needle}')")
+    return failures
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="edits_test_") as wd:
+        crc_lib = build_crc_so(wd)
+
+        n = test_round_trip()
+        print(f"  round-trip  {n}/{n} records preserved")
+
+        crc_fails = test_crc_cross(crc_lib)
+        if crc_fails:
+            print(f"  CRC cross   FAIL ({len(crc_fails)})")
+            for f in crc_fails[:8]:
+                print(f"    {f}")
+        else:
+            print("  CRC cross   on-chip crc32/crc32_two = binascii.crc32")
+
+        test_edits_crc_matches_chip(crc_lib)
+        print("  edits.bin   on-chip crc32_two recomputes to "
+              "gen_edits.pack header CRC")
+
+        neg_fails = test_negative()
+        if neg_fails:
+            print(f"  negative    FAIL ({len(neg_fails)})")
+            for f in neg_fails: print(f"    {f}")
+        else:
+            print("  negative    5/5 corruption cases detected")
+
+        wl_fails = test_whitelist()
+        if wl_fails:
+            print(f"  whitelist   FAIL ({len(wl_fails)})")
+            for f in wl_fails: print(f"    {f}")
+        else:
+            print("  whitelist   5/5 out-of-set tuples rejected")
+
+        if crc_fails or neg_fails or wl_fails:
+            sys.exit(1)
+        print("OK — edits.bin format + on-chip CRC path validated.")
+
+
+if __name__ == "__main__":
+    main()
