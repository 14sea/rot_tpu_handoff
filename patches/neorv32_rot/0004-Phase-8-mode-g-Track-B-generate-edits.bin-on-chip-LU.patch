+
+/* Header laid down by host/gen_edits.py.  Field order MUST mirror
+ * pack_edits() in host/gen_edits.py. */
+struct edits_hdr {
+    uint32_t magic;       /* 0x54494445 ('EDIT' written big-endian on wire) */
+    uint32_t version;     /* 1 */
+    uint32_t n_records;
+    uint32_t crc32;       /* CRC-32/ISO-HDLC over [version|n_records|records] */
