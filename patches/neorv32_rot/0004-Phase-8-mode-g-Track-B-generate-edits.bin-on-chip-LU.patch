+    const struct edits_hdr *eh =
+        (const struct edits_hdr *)EDITS_SCRATCH_ADDR;
+    if (eh->magic != EDITS_MAGIC) {
+        uart_puts("[!] edits.bin bad magic=");
+        uart_puthex32(eh->magic);
+        uart_puts(" expected="); uart_puthex32(EDITS_MAGIC);
+        uart_puts("\r\n"); while (1) {}
+    }
+    if (eh->version != EDITS_VERSION) {
+        uart_puts("[!] edits.bin version="); uart_puthex32(eh->version);
+        uart_puts(" unsupported (want "); uart_puthex32(EDITS_VERSION);
+        uart_puts(")\r\n"); while (1) {}
+    }
+    /* CRC covers [version | n_records | records] — magic is excluded so a
+     * partial read of the first 4 bytes can't pass the gate by luck. */
+    uint32_t need = sizeof(struct edits_hdr)
+                  + (uint32_t)eh->n_records * sizeof(struct edit_rec);
+    if (need > h->edits_sz) {
+        uart_puts("[!] edits.bin truncated: need="); uart_puthex32(need);
+        uart_puts(" have="); uart_puthex32(h->edits_sz);
+        uart_puts("\r\n"); while (1) {}
+    }
+    /* CRC payload = [version | n_records] (offsets 4..12, 8 B)
+     *             ∪ [records]            (offsets 16..16+8N).
+     * The `crc32` field at offset 12 is the gap — including it in the
+     * payload would be self-referential. */
+    const uint8_t *eb = (const uint8_t *)EDITS_SCRATCH_ADDR;
+    uint32_t records_bytes = (uint32_t)eh->n_records
+                           * (uint32_t)sizeof(struct edit_rec);
+    uint32_t got_crc = crc32_two(eb + 4, 8,
+                                 eb + sizeof(struct edits_hdr),
+                                 records_bytes);
+    if (got_crc != eh->crc32) {
+        uart_puts("[!] edits.bin CRC FAIL computed=");
+        uart_puthex32(got_crc);
+        uart_puts(" expected="); uart_puthex32(eh->crc32);
+        uart_puts(" — refusing to apply\r\n");
+        while (1) {}
+    }
+    uart_puts("[rot] edits.bin CRC OK n_records=");
+    uart_puthex32(eh->n_records); uart_puts("\r\n");
+
+    /* === Step 3: SHA-256 base.rbf vs baked golden === */
+    {
+        uint32_t H[8];
+        sha256_hw((const void *)(uintptr_t)TPU_SCRATCH_ADDR, h->tpu_sz, H);
+        uart_puts("[rot] base sha256=");
+        for (int i = 0; i < 8; i++) uart_puthex32(H[i]);
+        int match = 1;
+        for (int i = 0; i < 8; i++)
+            if (H[i] != rot_golden_tpu_bitstream[i]) { match = 0; break; }
+        if (!match) {
+            uart_puts(" [MISMATCH] golden=");
+            for (int i = 0; i < 8; i++)
+                uart_puthex32(rot_golden_tpu_bitstream[i]);
+            uart_puts("\r\n[!] base SHA mismatch — refusing EPCS write\r\n");
+            while (1) {}
+        }
+        uart_puts(" [OK]\r\n");
+    }
+
+    /* === Step 5: apply edits === */
+    for (uint32_t b = 0; b < sizeof(mode_g_dirty); b++) mode_g_dirty[b] = 0;
+    const struct edit_rec *recs =
+        (const struct edit_rec *)((const uint8_t *)EDITS_SCRATCH_ADDR
+                                  + sizeof(struct edits_hdr));
+    uint8_t *rbf = (uint8_t *)TPU_SCRATCH_ADDR;
+    uint32_t applied = 0;
+    for (uint32_t i = 0; i < eh->n_records; i++) {
+        lc_status_t st = lut_apply_with_canon(rbf,
+                                              recs[i].x, recs[i].y,
+                                              recs[i].n, recs[i].mask,
+                                              mode_g_dirty);
+        if (st != LC_OK) {
+            uart_puts("[!] edit#"); uart_puthex32(i);
+            uart_puts(" (x="); uart_puthex32(recs[i].x);
+            uart_puts(",y="); uart_puthex32(recs[i].y);
+            uart_puts(",n="); uart_puthex32(recs[i].n);
+            uart_puts(") rejected by lc_init status=");
+            uart_puthex32((uint32_t)st);
+            uart_puts(" — re-pin to clean column / fix manifest\r\n");
+            while (1) {}
+        }
+        applied++;
+    }
+    uart_puts("[rot] applied "); uart_puthex32(applied);
+    uart_puts(" edits\r\n");
+
+    /* === Step 6: per-frame CRC repair over the dirty set === */
+    lc_patch_rbf_crc_frames(rbf, mode_g_dirty);
+    uart_puts("[rot] CRC patched (dirty frames only)\r\n");
+
+    /* === Step 7: SHA-256 of result (informational, no golden compare) === */
+    {
+        uint32_t H[8];
+        sha256_hw((const void *)(uintptr_t)TPU_SCRATCH_ADDR, h->tpu_sz, H);
+        uart_puts("[rot] result sha256=");
+        for (int i = 0; i < 8; i++) uart_puthex32(H[i]);
+        uart_puts("\r\n");
+    }
+
+    /* === Steps 8-10: EPCS write + verify + ALTREMOTE_UPDATE === */
+    uart_puts("[rot] Phase 8 software path complete — "
+              "generated bitstream ready in SDRAM at ");
+    uart_puthex32(TPU_SCRATCH_ADDR);
+    uart_puts(".\r\n[rot] Phases 2-4 (EPCS write + ALTREMOTE_UPDATE) "
+              "not implemented yet; halting before any EPCS touch.\r\n");
+    while (1) {}
+}
