@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""
+gen_edits.py — Emit a Phase 8 mode 'g' edits.bin file.
+
+File format (matches docs/plan.md §Phase 8):
+
+    struct edits_hdr {
+        uint32_t magic;       /* 0x45444954 = 'EDIT' (big-endian on wire,
+                                 stored as little-endian u32 = 0x54494445) */
+        uint32_t version;     /* 1 */
+        uint32_t n_records;
+        uint32_t crc32;       /* CRC-32/ISO-HDLC over [version | n_records | records] */
+    };
+    struct edit_rec {
+        uint16_t x;           /* LAB X — must be in PIN_X whitelist */
+        uint16_t y;           /* LAB Y — must be in LAB_Y_CE6 whitelist */
+        uint16_t n;           /* LE N — even, 0..30 */
+        uint16_t mask;        /* 16-bit truth table */
+    };
+
+The CRC32 is computed on the host side and the on-chip mode 'g' handler
+re-validates it before applying any edit (see plan §Phase 8 integrity
+gate).  Note: CRC-32 is integrity, NOT authentication — see plan
+"Trust boundary" subsection.
+
+Each record is whitelist-checked against PIN_X / LAB_Y_CE6 / even-N
+(same set the on-chip lc_init enforces).  Out-of-whitelist tuples are
+rejected here so the SD card never carries records mode 'g' would
+refuse anyway.
+
+Input modes:
+  --json PATH      Read a JSON list `[{"x":10,"y":4,"n":0,"mask":"0xabcd"}, ...]`.
+                   `mask` accepts int (0..65535), hex string ("0x..."), or
+                   "0b..." binary.
+  --edit X,Y,N,M   Add one record from the CLI (may be repeated).
+
+Output: writes edits.bin to --out (default: ./edits.bin).
+"""
+import argparse
+import binascii
+import json
+import os
+import struct
+import sys
+
+# Same whitelist as host/gen_lutcodec_data.py and the on-chip lc_init.
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from gen_lutcodec_data import PIN_X, LAB_Y_CE6, N_VALUES  # noqa: E402
+
+MAGIC_LE = 0x54494445       # 'EDIT' big-endian-on-wire → 0x45 0x44 0x49 0x54
+                            # → little-endian-u32 = 0x54494445
+VERSION  = 1
+
+
+def _parse_mask(v):
+    if isinstance(v, int):
+        m = v
+    elif isinstance(v, str):
+        s = v.strip().lower()
+        if s.startswith("0x"):
+            m = int(s, 16)
+        elif s.startswith("0b"):
+            m = int(s, 2)
+        else:
+            m = int(s, 10)
+    else:
+        raise ValueError(f"mask must be int or str, got {type(v).__name__}")
+    if not (0 <= m <= 0xFFFF):
+        raise ValueError(f"mask 0x{m:x} out of u16 range")
+    return m
+
+
+def _validate_xyn(x, y, n):
+    if x not in PIN_X:
+        raise ValueError(
+            f"x={x} not in pin-friendly whitelist {PIN_X}; on-chip "
+            f"lc_init would return LC_ERR_X.  Re-pin this LUT in Quartus "
+            f"to a clean column.")
+    if y not in LAB_Y_CE6:
+        raise ValueError(
+            f"y={y} not in LAB_Y_CE6 whitelist; on-chip lc_init would "
+            f"return LC_ERR_Y.")
+    if n not in N_VALUES:
+        raise ValueError(
+            f"n={n} not in even-N set {N_VALUES}; on-chip lc_init would "
+            f"return LC_ERR_N.")
+
+
+def pack_edits(records):
+    """Build the edits.bin payload (header + records) with the correct CRC32.
+
+    `records` is an iterable of (x, y, n, mask) tuples.  Each is
+    whitelist-checked before packing.
+    """
+    body = bytearray()
+    for (x, y, n, mask) in records:
+        _validate_xyn(x, y, n)
+        body += struct.pack("<HHHH", x, y, n, mask & 0xFFFF)
+
+    # CRC payload = version | n_records | records (magic is excluded —
+    # see plan §Phase 8 integrity gate rationale).
+    crc_payload = struct.pack("<II", VERSION, len(records)) + bytes(body)
+    crc = binascii.crc32(crc_payload) & 0xFFFFFFFF
+
+    hdr = struct.pack("<IIII", MAGIC_LE, VERSION, len(records), crc)
+    return hdr + bytes(body)
+
+
+def parse_edits(blob):
+    """Parse + integrity-check an edits.bin blob.  Returns a list of
+    (x, y, n, mask) tuples.  Raises ValueError on any failure that
+    mode_g would also catch."""
+    if len(blob) < 16:
+        raise ValueError(f"edits.bin too short: {len(blob)} < 16 B header")
+    magic, version, n_records, crc = struct.unpack("<IIII", blob[:16])
+    if magic != MAGIC_LE:
+        raise ValueError(f"bad magic: 0x{magic:08x} != 0x{MAGIC_LE:08x}")
+    if version != VERSION:
+        raise ValueError(f"unsupported version: {version} != {VERSION}")
+    body_len = n_records * 8
+    if len(blob) < 16 + body_len:
+        raise ValueError(
+            f"edits.bin truncated: have {len(blob)} B, need "
+            f"{16 + body_len} for {n_records} records")
+    body = blob[16:16 + body_len]
+    crc_payload = blob[4:16 - 4] + body  # version + n_records + records
+    # equivalently: struct.pack("<II", version, n_records) + body
+    computed = binascii.crc32(crc_payload) & 0xFFFFFFFF
+    if computed != crc:
+        raise ValueError(
+            f"CRC32 mismatch: computed=0x{computed:08x} "
+            f"expected=0x{crc:08x}")
+    out = []
+    for i in range(n_records):
+        rec = struct.unpack("<HHHH", body[i * 8:(i + 1) * 8])
+        out.append(rec)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--json", help="JSON manifest path (list of {x,y,n,mask})")
+    ap.add_argument("--edit", action="append", default=[],
+                    metavar="X,Y,N,M",
+                    help="add one record; repeatable. Mask accepts 0x.. / 0b.. / decimal.")
+    ap.add_argument("--out", default="edits.bin",
+                    help="output path (default: edits.bin)")
+    ap.add_argument("--print", action="store_true",
+                    help="print parsed records after writing (smoke check)")
+    args = ap.parse_args()
+
+    records = []
+    if args.json:
+        with open(args.json) as f:
+            for entry in json.load(f):
+                records.append((
+                    int(entry["x"]),
+                    int(entry["y"]),
+                    int(entry["n"]),
+                    _parse_mask(entry["mask"]),
+                ))
+    for e in args.edit:
+        parts = e.split(",")
+        if len(parts) != 4:
+            raise SystemExit(f"--edit must be X,Y,N,M (got {e!r})")
+        x, y, n = int(parts[0]), int(parts[1]), int(parts[2])
+        records.append((x, y, n, _parse_mask(parts[3])))
+
+    if not records:
+        raise SystemExit("no records — pass --json and/or --edit")
+
+    blob = pack_edits(records)
+    with open(args.out, "wb") as f:
+        f.write(blob)
+    print(f"[gen_edits] wrote {args.out} ({len(blob)} B, {len(records)} records)")
+    if args.print:
+        for i, rec in enumerate(parse_edits(blob)):
+            print(f"  [{i}] x={rec[0]:2d} y={rec[1]:2d} n={rec[2]:2d} "
+                  f"mask=0x{rec[3]:04x}")
+
+
+if __name__ == "__main__":
+    main()
