--- /dev/null
+++ b/sw/stage2_loader/crc32_iso.h
@@ -0,0 +1,30 @@
+/* crc32_iso.h — CRC-32/ISO-HDLC (IEEE 802.3) helpers.
+ *
+ * Used by:
+ *   - main.c xmodem upload integrity check (file-level CRC)
+ *   - main.c mode 'g' (Phase 8) edits.bin header CRC, whose payload is
+ *     non-contiguous (skips the on-disk crc32 field) — see crc32_two.
+ *
+ * Parameters: poly 0xEDB88320 (reflected of 0x04C11DB7), init 0xFFFFFFFF,
+ * refin=refout=true, xorout 0xFFFFFFFF.  Matches Python binascii.crc32 so
+ * host-computed CRCs (gen_edits.py) validate byte-identically on chip.
+ */
+#ifndef CRC32_ISO_H
+#define CRC32_ISO_H
+
+#include <stdint.h>
+
+/* Accumulator form — pass `crc` from the previous chunk; for the first
+ * chunk use 0xFFFFFFFFu.  Does NOT apply the final xorout (~). */
+uint32_t crc32_update(uint32_t crc, const uint8_t *data, uint32_t len);
+
+/* One-shot CRC of a single contiguous range. */
+uint32_t crc32(const uint8_t *data, uint32_t len);
+
+/* CRC32 over two non-contiguous ranges, in order p1 then p2.  Required
+ * for the Phase 8 edits.bin gate: the CRC payload is
+ * [version|n_records] ∪ [records], skipping the `crc32` field itself. */
+uint32_t crc32_two(const uint8_t *p1, uint32_t n1,
+                   const uint8_t *p2, uint32_t n2);
+
+#endif /* CRC32_ISO_H */
