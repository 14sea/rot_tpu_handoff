index 3089f28..d8229ae 100644
--- a/sw/stage2_loader/main.c
+++ b/sw/stage2_loader/main.c
@@ -18,6 +18,7 @@
 #include "lutcodec.h"     /* Phase 7: LUT mask editor */
 #include "crc16.h"        /* Phase 7: RBF frame CRC */
 #include "crc32_iso.h"    /* Phase 8: edits.bin integrity CRC + xmodem CRC */
+#include "epcs.h"         /* Phase 3: EPCS16 driver via wb_altasmi_parallel */
 
 #define UBOOT_LOAD_ADDR   0x40000000UL
 #define KERNEL_LOAD_ADDR  0x40000000UL
@@ -238,6 +239,57 @@ static void dump_words(uint32_t addr, int n)
     uart_puts("\r\n");
 }
 
+/* Mode 'P': Phase 3 EPCS driver probe.
+ *
+ * Reads 64 B from EPCS offset 0x000000 and hex-dumps over UART (4 rows
+ * × ~22 chars = ~90 ms at 115200 8N1, comfortably under the rublock WD
+ * timeout window observed in Phase 4.1).  Then reads + prints the flash
+ * status register.  End-to-end check that the wb_altasmi_parallel
+ * handshake (read level + shift_bytes pulses + DV + dataout) and the
+ * RDSR path both work on silicon.
+ *
+ * Expected for an EPCS programmed with the AX301 factory ALINX image:
+ * the first 4 bytes are the .pof header (commonly 0x6A 0xA5 / similar
+ * boot tag depending on toolchain) followed by Cyclone IV configuration
+ * bitstream data.  Empty EPCS reads as all 0xFF.  Status register on a
+ * quiescent flash reads 0x00 (or 0x02 if WEL still set from a prior
+ * WREN, but our driver doesn't leave WEL hanging).
+ *
+ * Once Phase 4 is back and the WD is no longer a race, extend the read
+ * length to a full sector or two for offline-comparable dumps.
+ */
+#define EPCS_PROBE_BYTES   64u
+
+static void mode_epcs_probe(void)
+{
+    uart_puts("[stage2] Mode: EPCS probe — read 64 B @0x000000\r\n");
+
+    uint8_t buf[EPCS_PROBE_BYTES];
+    epcs_read(0x000000, sizeof(buf), buf);
+
+    for (uint32_t row = 0; row < sizeof(buf); row += 16) {
+        uart_puthex32(row);
+        uart_puts(":");
+        for (uint32_t col = 0; col < 16; col++) {
+            uart_putc(' ');
+            uint8_t b = buf[row + col];
+            const char hex[] = "0123456789abcdef";
+            uart_putc(hex[b >> 4]);
+            uart_putc(hex[b & 0xF]);
+        }
+        uart_puts("\r\n");
+    }
+
+    uint8_t st = epcs_read_status();
+    uart_puts("[epcs] RDSR=0x");
+    {
+        const char hex[] = "0123456789abcdef";
+        uart_putc(hex[st >> 4]);
+        uart_putc(hex[st & 0xF]);
+    }
+    uart_puts(" probe DONE\r\n");
+}
+
 /* Mode 'u': Load U-Boot (original behavior) */
 static void mode_uboot(void)
 {
@@ -916,7 +968,7 @@ int main(void)
      * ROM to fall back to, so we must NOT drop into mode_uboot on timeout.
      * Sit forever waiting for a host byte — same idle behavior as the
      * re-prompt loop. */
-    uart_puts("[stage2] l=xmodem s=smoke d=dump w=wtest W=wmulti R=rdhdr B=baud b=bootSD t=tpuVerify g=genRbf\r\n");
+    uart_puts("[stage2] l=xmodem s=smoke d=dump w=wtest W=wmulti R=rdhdr B=baud b=bootSD t=tpuVerify g=genRbf P=epcsProbe\r\n");
     uart_puts("[stage2] CRTM locked — waiting for host command\r\n");
     int mode;
     while ((mode = uart_getc_timeout(3600000)) < 0) { }
@@ -945,6 +997,8 @@ int main(void)
             mode_tpu_verify();         /* Phase 1: SD-side TPU SHA verify, halts */
         } else if (mode == 'g') {
             mode_generate();           /* Phase 8: LUT mask editor, halts pre-EPCS */
+        } else if (mode == 'P') {
+            mode_epcs_probe();         /* Phase 3: EPCS driver diagnostic */
         } else {
             uart_puts("[!] unknown mode byte — ignored\r\n");
         }
