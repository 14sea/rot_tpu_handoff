diff --git a/sw/stage2_loader/epcs.c b/sw/stage2_loader/epcs.c
new file mode 100644
index 0000000..c0b7fad
--- /dev/null
+++ b/sw/stage2_loader/epcs.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * epcs.c — Phase 3 EPCS16 driver against wb_altasmi_parallel @0xF2000000.
+ *
+ * Per-byte handshake summary (verified against altasmi_parallel doc +
+ * the wrapper RTL):
+ *
+ *   READ: set ADDR; set CTRL.read=1; for each byte { pulse shift_bytes;
+ *         wait STATUS.data_valid; read DATAOUT (clears DV) }; clear
+ *         CTRL.read.  The megafunction sends READ opcode + 24-bit addr
+ *         on the rising edge of `read`, asserts /CS for the duration,
+ *         deasserts /CS on the falling edge of `read`.
+ *
+ *   WRITE (program page): pulse wren; wait !busy; set ADDR; set
+ *         CTRL.write=1; wait !busy; for each byte (≤256) { write
+ *         DATAIN; pulse shift_bytes; wait !busy }; clear CTRL.write.
+ *         /CS is asserted while write is high; deasserting kicks the
+ *         flash to start internal programming.  Poll RDSR.WIP until
+ *         clear (typical 1-3 ms).
+ *
+ *   SECTOR_ERASE: pulse wren; wait !busy; set ADDR; set
+ *         CTRL.sec_erase=1; wait !busy; clear CTRL.sec_erase.  Poll
+ *         RDSR.WIP until clear (typical 100-500 ms).
+ *
+ *   READ_STATUS: set CTRL.rd_status=1; wait !busy; read ESTAT; clear
+ *         CTRL.rd_status.
+ */
+
+#include "epcs.h"
+#include <neorv32.h>
+
+#define WB_AM_BASE      0xF2000000UL
+#define WB_AM_CTRL      ((volatile uint32_t *)(WB_AM_BASE + 0x00))
+#define WB_AM_ADDR      ((volatile uint32_t *)(WB_AM_BASE + 0x04))
+#define WB_AM_DATAIN    ((volatile uint32_t *)(WB_AM_BASE + 0x08))
+#define WB_AM_STATUS    ((volatile uint32_t *)(WB_AM_BASE + 0x0C))
+#define WB_AM_DATAOUT   ((volatile uint32_t *)(WB_AM_BASE + 0x10))
+#define WB_AM_ESTAT     ((volatile uint32_t *)(WB_AM_BASE + 0x14))
+
+#define CTRL_READ          (1u << 0)
+#define CTRL_WRITE         (1u << 1)
+#define CTRL_SEC_ERASE     (1u << 2)
+#define CTRL_RD_STATUS     (1u << 3)
+#define CTRL_SHIFT_BYTES   (1u << 4)
+#define CTRL_WREN          (1u << 5)
+#define CTRL_RESET         (1u << 6)
+
+#define STATUS_BUSY        (1u << 0)
+#define STATUS_DV          (1u << 1)
+#define STATUS_ILL_ERASE   (1u << 2)
+#define STATUS_ILL_WRITE   (1u << 3)
+
+static inline void am_ctrl_write(uint32_t levels_plus_pulses)
+{
+    /* The wrapper's CTRL register is W-only for pulse bits; level bits
+     * stay set until firmware writes a CTRL with the bit cleared. */
+    *WB_AM_CTRL = levels_plus_pulses;
+}
+
+static inline uint32_t am_status(void) { return *WB_AM_STATUS; }
+
+static inline void wait_not_busy(void)
+{
+    while (am_status() & STATUS_BUSY) { }
+}
+
+static inline void wait_data_valid(void)
+{
+    while (!(am_status() & STATUS_DV)) { }
+}
+
+void epcs_read(uint32_t addr, uint32_t len, uint8_t *buf)
+{
+    *WB_AM_ADDR = addr & 0x00FFFFFFu;
+    am_ctrl_write(CTRL_READ);          /* assert read level → /CS low, send opcode+addr */
+    wait_not_busy();                   /* megafunction finishes pre-amble */
+
+    for (uint32_t i = 0; i < len; i++) {
+        am_ctrl_write(CTRL_READ | CTRL_SHIFT_BYTES);  /* hold read, pulse shift */
+        wait_data_valid();
+        buf[i] = (uint8_t)(*WB_AM_DATAOUT);          /* read clears DV */
+    }
+
+    am_ctrl_write(0);                  /* deassert read → /CS high */
+    wait_not_busy();
+}
+
+uint8_t epcs_read_status(void)
+{
+    am_ctrl_write(CTRL_RD_STATUS);     /* assert rd_status → megafunction cycles RDSR */
+    wait_not_busy();
+    uint8_t s = (uint8_t)(*WB_AM_ESTAT);
+    am_ctrl_write(0);                  /* deassert */
+    return s;
+}
+
+static void poll_wip_clear(void)
+{
+    /* Spin until flash WIP bit clears.  No external timeout — caller
+     * trusts the chip's datasheet timing.  Worst case: ~3 s for sector
+     * erase per EPCS16 spec; at 30 MHz that's ~100 M status reads. */
+    while (epcs_read_status() & EPCS_STATUS_WIP) { }
+}
+
+int epcs_erase_sector(uint32_t addr)
+{
+    am_ctrl_write(CTRL_WREN);          /* one-cycle pulse: send WREN command */
+    wait_not_busy();
+
+    *WB_AM_ADDR = addr & 0x00FFFFFFu;
+    am_ctrl_write(CTRL_SEC_ERASE);     /* assert sec_erase: send SE opcode+addr */
+    wait_not_busy();
+    am_ctrl_write(0);                  /* deassert → flash starts internal erase */
+
+    poll_wip_clear();
+
+    if (am_status() & STATUS_ILL_ERASE) {
+        am_ctrl_write(CTRL_RESET);     /* clear sticky for next op */
+        return -1;
+    }
+    return 0;
+}
+
+int epcs_program_page(uint32_t addr, uint32_t len, const uint8_t *buf)
+{
+    if (len == 0) return 0;
+    if (len > EPCS_PAGE_SIZE) return -1;
+
+    am_ctrl_write(CTRL_WREN);
+    wait_not_busy();
+
+    *WB_AM_ADDR = addr & 0x00FFFFFFu;
+    am_ctrl_write(CTRL_WRITE);         /* assert write: send PROGRAM opcode+addr */
+    wait_not_busy();
+
+    for (uint32_t i = 0; i < len; i++) {
+        *WB_AM_DATAIN = buf[i];
+        am_ctrl_write(CTRL_WRITE | CTRL_SHIFT_BYTES);
+        wait_not_busy();
+    }
+
+    am_ctrl_write(0);                  /* deassert → flash starts programming */
+
+    poll_wip_clear();
+
+    if (am_status() & STATUS_ILL_WRITE) {
+        am_ctrl_write(CTRL_RESET);
+        return -1;
+    }
+    return 0;
+}
diff --git a/sw/stage2_loader/epcs.h b/sw/stage2_loader/epcs.h
new file mode 100644
index 0000000..63d94d9
--- /dev/null
+++ b/sw/stage2_loader/epcs.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * epcs.h — Phase 3 EPCS16 driver for the RoT stage2 loader.
+ *
+ * Drives the wb_altasmi_parallel wrapper at 0xF2000000 (Phase 2 silicon),
+ * which is a thin pass-through to the qmegawiz-generated altasmi_parallel
+ * megafunction (EPCS16 / 256 B page / USE_ASMIBLOCK=ON).
+ *
+ * The wrapper's register map (see rtl/wb_altasmi_parallel.v:14-30):
+ *   0x00 CTRL    {read, write, sec_erase, rd_status} (level)
+ *                {shift_bytes, wren, reset} (1-cycle pulse)
+ *   0x04 ADDR    [23:0]
+ *   0x08 DATAIN  [7:0]
+ *   0x0C STATUS  {busy, data_valid_sticky, illegal_erase, illegal_write}
+ *   0x10 DATAOUT [7:0] (reading clears data_valid)
+ *   0x14 ESTAT   [7:0] flash status_out (most-recent RDSR result)
+ *
+ * Note: Phase 4 epcs_remote_reconfig() is intentionally NOT declared here
+ * — it lives in a different IP (wb_altremote_update @ 0xF3000000) and the
+ * direct-primitive wrapper for it is currently blocked.  See
+ * [[reference-rublock-complexity]] (memory) for the path back to Phase 4.
+ */
+
+#ifndef ROT_EPCS_H
+#define ROT_EPCS_H
+
+#include <stdint.h>
+
+#define EPCS_PAGE_SIZE     256u      /* program page */
+#define EPCS_SECTOR_SIZE   65536u    /* 64 KB sector (EPCS16) */
+#define EPCS_TOTAL_BYTES   0x200000u /* EPCS16 = 2 MB */
+
+/* SPI status register bit 0 = WIP (Write In Progress, 1 = busy). */
+#define EPCS_STATUS_WIP    0x01u
+
+/*
+ * Read len bytes from EPCS starting at addr into buf.
+ * Stalls until the per-byte handshake completes for all len bytes.
+ * No length cap from the wrapper — the megafunction handles addr
+ * rollover; we use it as plain sequential read.
+ */
+void epcs_read(uint32_t addr, uint32_t len, uint8_t *buf);
+
+/*
+ * Read flash status register.  Returns the 8-bit status_out byte.
+ * Bit 0 = WIP.  Used after erase/program to poll for completion.
+ */
+uint8_t epcs_read_status(void);
+
+/*
+ * Erase the 64 KB sector containing addr.  Issues WREN then SE-with-
+ * address; polls flash status until WIP clears (typical 100-500 ms,
+ * max ~3 s per EPCS16 datasheet).  Returns 0 on success, -1 if the
+ * wrapper's illegal_erase sticky flag fired (e.g. addr beyond chip).
+ */
+int epcs_erase_sector(uint32_t addr);
+
+/*
+ * Program up to len bytes (≤ EPCS_PAGE_SIZE) starting at addr.
+ * Caller must ensure (addr + len) does not cross a page boundary
+ * (the flash itself wraps within the page, which would corrupt the
+ * write — checked by the wrapper's illegal_write sticky).
+ * Issues WREN, sets write level, streams bytes via DATAIN +
+ * shift_bytes pulses, then deasserts write and polls until WIP clears
+ * (typical 1-3 ms).  Returns 0 on success, -1 on illegal_write.
+ */
+int epcs_program_page(uint32_t addr, uint32_t len, const uint8_t *buf);
+
+#endif /* ROT_EPCS_H */
