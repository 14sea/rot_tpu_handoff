-    reg ctrl_write;
-    reg ctrl_sec_erase;
-    reg ctrl_rd_status;
-    reg ctrl_shift_bytes;
-    reg ctrl_wren;
-    reg ctrl_reset;
-    reg ctrl_rden_drop;
-    reg ctrl_fast_read;
+    // ── MMIO-visible control registers ────────────────────────────────
+    reg ctrl_write;       // unused first round
+    reg ctrl_sec_erase;   // unused first round
+    reg ctrl_rd_status;   // unused first round
+    reg ctrl_shift_bytes; // unused first round (auto-clear)
+    reg ctrl_wren;        // unused first round (auto-clear)
+    reg ctrl_reset;       // 1-cycle pulse: abort + clear (auto-clear)
+    reg ctrl_rden_drop;   // unused first round (auto-clear)
+    reg ctrl_fast_read;   // LEVEL: 1 starts/sustains FAST_READ op
     reg [23:0] addr_reg;
     reg [7:0]  datain_reg;
 
-    // ── altasmi outputs ───────────────────────────────────────────────
-    wire        am_busy;
-    wire        am_data_valid;
-    wire [7:0]  am_dataout;
-    wire [7:0]  am_status_out;
-    wire        am_illegal_erase;
-    wire        am_illegal_write;
-    wire [23:0] am_read_addr;       // NH7 fix: must be connected so Quartus
-                                    // doesn't prune read_add_cntr →
-                                    // end_read_reg.  Surfaced over MMIO 0x18.
-
-    // ── Power-on reset stretcher (NH6 fix) ────────────────────────────
-    // altasmi_parallel spec: reset must be asserted ≥250 ns at power-up
-    // to initialize the megafunction (FIFO counters, internal FSM).
-    // Without this, am_data_valid is level-held high during pre-amble on
-    // READ-class opcodes — exactly the symptom captured by patch 0010's
-    // diagnostic STATUS-trace (Phase A RDSR works, Phase B READ hangs at
-    // pre-amble with STATUS=0x03 across 10M poll iters).
-    //
-    // Stretch the megafunction's reset for 31 cycles after rst_n
-    // deasserts (= 620 ns @ 50 MHz, 2.5× the spec minimum), then OR
-    // with a firmware-issued soft-reset pulse so firmware can still
-    // request a soft-reset on demand.
-    reg [4:0] am_por_cnt;
-    wire am_por_done = &am_por_cnt;  // saturates at 5'b11111
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n)             am_por_cnt <= 5'd0;
-        else if (!am_por_done)  am_por_cnt <= am_por_cnt + 5'd1;
-    end
+    reg dataout_read_req; // pulsed when firmware reads DATAOUT
+
+    // ── SPI clock divider ─────────────────────────────────────────────
+    // 4-cycle period: SCK = sysclk/4 = 12.5 MHz @ 50 MHz.  Phase
+    // (within one period):
+    //   cnt=0: SCK low.  MOSI just changed (assigned at prior sck_fall).
+    //   cnt=1: SCK low.
+    //   cnt=2: SCK high.  Stable mid-high — sample MISO here.
+    //   cnt=3: SCK high.  Falling edge events.
+    // sck_q is the output to the asmiblock.
+
+    reg [1:0]  sck_div_cnt;
+    reg        sck_q;
+    reg        sck_active;
 
-    // NH13 (2026-05-17 silicon): the original `am_reset_in = ctrl_reset
-    // | ~am_por_done` left firmware-issued ctrl_reset as a 1-cycle pulse
-    // (~20 ns @ 50 MHz), well below the megafunction's 250 ns reset
-    // spec.  Effect: the megafunction's internal read_add_cntr (lpm_counter)
-    // did NOT actually reset on CTRL.b6 writes, so consecutive
-    // FAST_READs in the same boot returned non-deterministic bytes
-    // (counter state leaked across operations).  Stretch the firmware-
-    // issued pulse to 16 cycles (= 320 ns @ 50 MHz) via a small load-
-    // -and-count-down counter; sticky flag clearing logic still triggers
-    // on the 1-cycle ctrl_reset (idempotent for multiple cycles, harmless).
-    reg [4:0] ctrl_reset_cnt;
-    wire ctrl_reset_active = |ctrl_reset_cnt;
     always @(posedge clk or negedge rst_n) begin
-        if (!rst_n)                 ctrl_reset_cnt <= 5'd0;
-        else if (ctrl_reset)        ctrl_reset_cnt <= 5'd16;
-        else if (ctrl_reset_active) ctrl_reset_cnt <= ctrl_reset_cnt - 5'd1;
+        if (!rst_n) begin
+            sck_div_cnt <= 2'd0;
+            sck_q       <= 1'b0;
+        end else if (!sck_active) begin
+            sck_div_cnt <= 2'd0;
+            sck_q       <= 1'b0;
+        end else begin
+            sck_div_cnt <= sck_div_cnt + 2'd1;
+            if      (sck_div_cnt == 2'd1) sck_q <= 1'b1; // rising into cnt=2
+            else if (sck_div_cnt == 2'd3) sck_q <= 1'b0; // falling into cnt=0
+        end
     end
-    wire am_reset_in = ctrl_reset_active | ~am_por_done;
-
-    // Generated by qmegawiz from rtl/ip/epcs_ctrl.v (altasmi_parallel
-    // wrapper, EPCS16, Cyclone IV E, USE_ASMIBLOCK=ON — drives the
-    // dedicated AS pins DCLK/nCSO/ASDO/DATA0 automatically).
-    // NH8 v3: firmware-controlled rden via CTRL.b7 pulse.
-    //
-    // History: NH8 v1 (rden=~dataout_read_req) preserved end_read_reg
-    // at synthesis but never fired it at runtime — the rden-drop
-    // window misaligned with data_valid_wire pulses.  NH8 v2 (rden=0)
-    // fired end_read_reg too aggressively — FSM aborted before
-    // shifting any data byte.  Trace evidence: B1 STATUS=0x00 right
-    // after CTRL=READ (busy never even asserted; the operation
-    // exited immediately).
-    //
-    // Correct semantics: hold rden=1 while bytes are being shifted,
-    // drop rden=0 for one cycle AFTER the final byte's data_valid
-    // pulse to signal "this was the last byte → terminate read."
-    //
-    // Default am_rden=1.  Two termination paths, both supported:
-    //   (a) Firmware pulses CTRL.b7=1 (single-cycle RDEN_DROP).  Race-prone:
-    //       the rden=0 pulse must align with the megafunction's single-cycle
-    //       data_valid_wire pulse for end_read_reg to fire.  Empirically
-    //       unreliable on NH9 (C4 TIMEOUT 3/3 reproducible).
-    //   (b) NH10 AUTO-TERMINATE: when firmware clears the FAST_READ level
-    //       bit (CTRL=0) while the megafunction is still busy, the wrapper
-    //       HOLDS am_rden=0 until busy drops.  end_read_reg gets unlimited
-    //       cycles to align with the data_valid_wire pulse — termination
-    //       always completes within one shift cycle (~150 sysclks).
-    //   Firmware API: just write CTRL=0 then wait_not_busy().  The b7 pulse
-    //   is retained for back-compat but is now redundant.
-    wire am_rden = ~ctrl_rden_drop & ~(am_busy & ~ctrl_fast_read);
-
-    epcs_ctrl u_am (
-        .clkin         (clk),
-        .reset         (am_reset_in),
-        .addr          (addr_reg),
-        .datain        (datain_reg),
-        .rden          (am_rden),
-        .fast_read     (ctrl_fast_read),
-        .write         (ctrl_write),
-        .sector_erase  (ctrl_sec_erase),
-        .read_status   (ctrl_rd_status),
-        .shift_bytes   (ctrl_shift_bytes),
-        .wren          (ctrl_wren),
-        .busy          (am_busy),
-        .data_valid    (am_data_valid),
-        .dataout       (am_dataout),
-        .status_out    (am_status_out),
-        .illegal_erase (am_illegal_erase),
-        .illegal_write (am_illegal_write),
-        .read_address  (am_read_addr)
-    );
 
-    // ── NH17: per-byte event detector (am_read_addr edge) ────────────
-    // Replaces am_data_valid as the latch trigger.  am_data_valid is
-    // LEVEL-LOCKED by the megafunction's dvalid_reg (epcs_ctrl.v line
-    // 745: sets on first end_read_byte, cleared only by end_op_wire),
-    // so NH16-fw's "firmware-side discard phantom byte" failed —
-    // post-clear re-latch fires immediately with the stale am_dataout
-    // because the level-locked am_data_valid is still high before the
-    // next real end_read_byte event.
-    //
-    // am_read_addr = megafunction's read_add_reg (epcs_ctrl.v line
-    // 1807), enabled by (end_read_byte & end_one_cyc_pos &
-    // ~end_operation) per line 1159 → updates exactly ONCE per byte
-    // during a read op.  Detecting transitions of this 24-bit value
-    // gives a clean per-byte strobe to replace level-locked DV.
-    //
-    // Clocking: read_add_reg is on negedge clkin_wire (line 992-994);
-    // wrapper samples on posedge clk → 10 ns of clock-edge margin at
-    // 50 MHz, single sync flop is sufficient.  No metastability
-    // concern (same clock domain, opposite edges).
-    //
-    // 24-bit compare (not LSB-only): read_add_cntr increments multiple
-    // times between end_read_byte events (cnt_en=1 always, clk_en gates
-    // on data_valid_wire which is also level-locked), so the captured
-    // am_read_addr can jump by N>1 per event.  LSB-only would miss
-    // events where the jump happens to keep LSB unchanged.
-    //
-    // Reset alignment: clear on ctrl_reset (NH13 wrapper trigger that
-    // stretches am_reset_in to 16 cycles) so wrapper-side baseline
-    // matches megafunction's read_add_reg=0 post-reset.
-    reg [23:0] am_read_addr_d;
+    // sample_pulse: 1-cycle pulse during cnt==2 (mid SCK-high); MISO
+    // has had cnt 0+1 (40 ns) since the chip's prior falling edge to
+    // propagate to miso_in.
+    // fall_pulse: 1-cycle pulse during cnt==3 (SCK still high; we
+    // schedule changes that take effect at cnt==0 of next period,
+    // which is the physical SCK falling edge).
+    wire sample_pulse = sck_active && (sck_div_cnt == 2'd2);
+    wire fall_pulse   = sck_active && (sck_div_cnt == 2'd3);
+
+    // ── SPI master FSM ────────────────────────────────────────────────
+    localparam [2:0]
+        S_IDLE  = 3'd0,
+        S_PRE   = 3'd1,  // CS-to-SCK setup hold
+        S_LOAD  = 3'd2,  // 1-cycle byte reload between bytes
+        S_SHIFT = 3'd3,  // 8-bit shift in/out
+        S_PAUSE = 3'd4,  // post-data-byte stall; CS held low
+        S_TAIL  = 3'd5;  // CS-high recovery before going idle
+
+    localparam [2:0]
+        P_CMD = 3'd0,
+        P_A2  = 3'd1,
+        P_A1  = 3'd2,
+        P_A0  = 3'd3,
+        P_DUM = 3'd4,
+        P_DAT = 3'd5;
+
+    reg [2:0] state;
+    reg [2:0] phase;
+    reg [7:0] mosi_shift;
+    reg [7:0] miso_shift;
+    reg [2:0] bit_cnt;
+    reg [3:0] tick_cnt;       // generic counter for PRE/TAIL hold
+    reg       byte_valid;     // 1-cycle pulse when DAT byte completes
+    reg [23:0] raddr_q;       // diag byte-progress counter
+
+    wire op_busy = (state != S_IDLE);
+
+    function [2:0] next_phase;
+        input [2:0] cur;
+        case (cur)
+            P_CMD: next_phase = P_A2;
+            P_A2:  next_phase = P_A1;
+            P_A1:  next_phase = P_A0;
+            P_A0:  next_phase = P_DUM;
+            P_DUM: next_phase = P_DAT;
+            P_DAT: next_phase = P_DAT;
+            default: next_phase = P_DAT;
+        endcase
+    endfunction
+
+    function [7:0] phase_load;
+        input [2:0] p;
+        input [23:0] a;
+        case (p)
+            P_CMD: phase_load = 8'h0B;
+            P_A2:  phase_load = a[23:16];
+            P_A1:  phase_load = a[15:8];
+            P_A0:  phase_load = a[7:0];
+            P_DUM: phase_load = 8'h00;
+            P_DAT: phase_load = 8'h00;
+            default: phase_load = 8'h00;
+        endcase
+    endfunction
