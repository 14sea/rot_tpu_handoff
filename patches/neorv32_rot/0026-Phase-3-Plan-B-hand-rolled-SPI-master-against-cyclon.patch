+            if (ctrl_reset) begin
+                state      <= S_IDLE;
+                phase      <= P_CMD;
+                mosi_shift <= 8'h00;
+                miso_shift <= 8'h00;
+                bit_cnt    <= 3'd0;
+                tick_cnt   <= 4'd0;
+                raddr_q    <= 24'd0;
+                cs_n_q     <= 1'b1;
+                oe_q       <= 1'b1;
+                mosi_q     <= 1'b0;
+                sck_active <= 1'b0;
+            end else begin
+                case (state)
+                    // -----------------------------------------------------
+                    S_IDLE: begin
+                        cs_n_q     <= 1'b1;
+                        oe_q       <= 1'b1;
+                        mosi_q     <= 1'b0;
+                        sck_active <= 1'b0;
+                        if (ctrl_fast_read) begin
+                            phase    <= P_CMD;
+                            raddr_q  <= addr_reg;
+                            tick_cnt <= 4'd0;
+                            cs_n_q   <= 1'b0;
+                            oe_q     <= 1'b0;
+                            state    <= S_PRE;
