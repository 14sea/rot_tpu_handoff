     always @(posedge clk or negedge rst_n) begin
-        if (!rst_n)          am_read_addr_d <= 24'd0;
-        else if (ctrl_reset) am_read_addr_d <= 24'd0;
-        else                 am_read_addr_d <= am_read_addr;
+        if (!rst_n) begin
+            state       <= S_IDLE;
+            phase       <= P_CMD;
+            mosi_shift  <= 8'h00;
+            miso_shift  <= 8'h00;
+            bit_cnt     <= 3'd0;
+            tick_cnt    <= 4'd0;
+            byte_valid  <= 1'b0;
+            raddr_q     <= 24'd0;
+            cs_n_q      <= 1'b1;
+            oe_q        <= 1'b1;
+            mosi_q      <= 1'b0;
+            sck_active  <= 1'b0;
