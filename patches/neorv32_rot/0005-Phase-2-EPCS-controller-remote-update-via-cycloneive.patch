From 1ae124441a66a1e1bb05f4a472a53f4df65bf81e Mon Sep 17 00:00:00 2001
From: 14sea <wanhuaning@gmail.com>
Date: Sat, 16 May 2026 23:55:36 +0100
Subject: [PATCH] Phase 2: EPCS controller + remote-update via
 cycloneive_rublock direct
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ROT host bitstream now exposes two new Wishbone XBUS slaves:

  0xF2000000  wb_altasmi_parallel  — EPCS16 controller wrapping the
                                     qmegawiz-generated epcs_ctrl
                                     (altasmi_parallel, USE_ASMIBLOCK=ON
                                     so the dedicated AS pins are driven
                                     automatically).  Thin register-map:
                                     firmware drives the byte-level
                                     handshake (CTRL/ADDR/DATAIN/STATUS/
                                     DATAOUT/ESTAT).

  0xF3000000  wb_altremote_update  — 29-bit shift FSM directly
                                     instantiating cycloneive_rublock,
                                     bypassing the Lite-Edition
                                     altremote_update IP (which strips
                                     write_param/data_in for Cyclone IV E
                                     in REMOTE mode and refuses param
                                     overrides via qmegawiz silent).

QSF additions: USE_CONFIGURATION_DEVICE ON, CYCLONEIII_CONFIGURATION_*
= EPCS16/Active Serial, INTERNAL_FLASH_UPDATE_MODE = REMOTE, plus the
new VERILOG_FILE + QIP_FILE entries.

IP bootstrap is CLI-only: rtl/ip/epcs_ctrl.v hand-crafted with the
// Retrieval info: header → qmegawiz -silent regenerates the 80 KB
clearbox-expanded implementation.  No GUI step required.

Fit: 8,819 / 10,320 LE (85 %); +556 LE vs pre-Phase-2.  Setup slack
slow 85C -1.350 ns (was -0.927 pre-Phase-2; pre-existing NEORV32-core
timing tightness — not introduced by this commit, ~0.4 ns worse).

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 quartus/neorv32_demo.qsf  |   17 +
 rtl/ax301_top.vhd         |  103 +-
 rtl/ip/epcs_ctrl.qip      |    4 +
 rtl/ip/epcs_ctrl.v        | 1974 +++++++++++++++++++++++++++++++++++++
 rtl/wb_altasmi_parallel.v |  184 ++++
 rtl/wb_altremote_update.v |  278 ++++++
 6 files changed, 2552 insertions(+), 8 deletions(-)
 create mode 100644 rtl/ip/epcs_ctrl.qip
 create mode 100644 rtl/ip/epcs_ctrl.v
 create mode 100644 rtl/wb_altasmi_parallel.v
 create mode 100644 rtl/wb_altremote_update.v

diff --git a/quartus/neorv32_demo.qsf b/quartus/neorv32_demo.qsf
index 64562d2..a22f192 100644
--- a/quartus/neorv32_demo.qsf
+++ b/quartus/neorv32_demo.qsf
@@ -76,6 +76,13 @@ set_global_assignment -name VERILOG_FILE ../rtl/wb_sdram_ctrl.v
 set_global_assignment -name VERILOG_FILE ../rtl/sdram_ctrl.v
 set_global_assignment -name VERILOG_FILE ../rtl/wb_sha256.v
 set_global_assignment -name VERILOG_FILE ../rtl/sha256/sha256_core.v
+set_global_assignment -name VERILOG_FILE ../rtl/wb_altasmi_parallel.v
+set_global_assignment -name VERILOG_FILE ../rtl/wb_altremote_update.v
+
+# ── Phase 2 IP: EPCS controller (altasmi_parallel, qmegawiz silent) ─────────
+# Generated via:  cd ../rtl/ip && qmegawiz -silent epcs_ctrl.v
+# Source-of-truth Retrieval info lives at the bottom of epcs_ctrl.v itself.
+set_global_assignment -name QIP_FILE ../rtl/ip/epcs_ctrl.qip
 
 # ── Timing constraint ────────────────────────────────────────────────────────
 set_global_assignment -name SDC_FILE neorv32_demo.sdc
@@ -149,6 +156,16 @@ set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
 set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
 set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
 
+# ── Remote-update / EPCS configuration (Phase 2) ────────────────────────────
+# Active Serial boot from EPCS16 with remote-update support so the running
+# host bitstream can self-reconfigure via altremote_update (page 1 = target).
+# Quartus 21.1 uses CYCLONEIII_* assignment names for the Cyclone IV E
+# family (no separate CYCLONEIV_* aliases registered in this build).
+set_global_assignment -name USE_CONFIGURATION_DEVICE ON
+set_global_assignment -name CYCLONEIII_CONFIGURATION_DEVICE EPCS16
+set_global_assignment -name CYCLONEIII_CONFIGURATION_SCHEME "ACTIVE SERIAL"
+set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "REMOTE"
+
 # ── CE10 timing push: exploit extra LEs for placement/routing headroom ──────
 set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
 set_global_assignment -name PLACEMENT_EFFORT_MULTIPLIER 4.0
diff --git a/rtl/ax301_top.vhd b/rtl/ax301_top.vhd
index 7aff475..fb821ec 100644
--- a/rtl/ax301_top.vhd
+++ b/rtl/ax301_top.vhd
@@ -116,13 +116,60 @@ architecture rtl of ax301_top is
     );
   end component;
 
-  -- XBUS mux: SHA range at 0xF10xxxxx, everything else to SDRAM bridge
-  signal sha_range  : std_ulogic;
+  -- ── wb_altasmi_parallel (EPCS controller, base 0xF2000000) ─────────────
+  component wb_altasmi_parallel is
+    port (
+      clk        : in  std_ulogic;
+      rst_n      : in  std_ulogic;
+      xbus_adr   : in  std_ulogic_vector(31 downto 0);
+      xbus_dat_w : in  std_ulogic_vector(31 downto 0);
+      xbus_sel   : in  std_ulogic_vector(3 downto 0);
+      xbus_we    : in  std_ulogic;
+      xbus_stb   : in  std_ulogic;
+      xbus_cyc   : in  std_ulogic;
+      xbus_dat_r : out std_ulogic_vector(31 downto 0);
+      xbus_ack   : out std_ulogic;
+      xbus_err   : out std_ulogic
+    );
+  end component;
+
+  -- ── wb_altremote_update (remote-reconfig, base 0xF3000000) ─────────────
+  component wb_altremote_update is
+    port (
+      clk        : in  std_ulogic;
+      rst_n      : in  std_ulogic;
+      xbus_adr   : in  std_ulogic_vector(31 downto 0);
+      xbus_dat_w : in  std_ulogic_vector(31 downto 0);
+      xbus_sel   : in  std_ulogic_vector(3 downto 0);
+      xbus_we    : in  std_ulogic;
+      xbus_stb   : in  std_ulogic;
+      xbus_cyc   : in  std_ulogic;
+      xbus_dat_r : out std_ulogic_vector(31 downto 0);
+      xbus_ack   : out std_ulogic;
+      xbus_err   : out std_ulogic
+    );
+  end component;
+
+  -- XBUS mux: SHA @0xF10xxxxx, ASMI @0xF20xxxxx, REMOTE @0xF30xxxxx, else SDRAM
+  signal sha_range    : std_ulogic;
+  signal asmi_range   : std_ulogic;
+  signal remote_range : std_ulogic;
+  signal periph_range : std_ulogic;  -- any of the F1x/F2x/F3x slaves
+
   signal sha_stb    : std_ulogic;
+  signal asmi_stb   : std_ulogic;
+  signal remote_stb : std_ulogic;
   signal sdram_stb  : std_ulogic;
+
   signal sha_dat    : std_ulogic_vector(31 downto 0);
   signal sha_ack    : std_ulogic;
   signal sha_err    : std_ulogic;
+  signal asmi_dat   : std_ulogic_vector(31 downto 0);
+  signal asmi_ack   : std_ulogic;
+  signal asmi_err   : std_ulogic;
+  signal remote_dat : std_ulogic_vector(31 downto 0);
+  signal remote_ack : std_ulogic;
+  signal remote_err : std_ulogic;
   signal sdram_dat  : std_ulogic_vector(31 downto 0);
   signal sdram_ack  : std_ulogic;
   signal sdram_err  : std_ulogic;
@@ -240,13 +287,23 @@ begin
   LED(3) <= not dbg_leds(3);
 
   -- ── Wishbone → SDRAM bridge ───────────────────────────────────────────────
-  -- ── XBUS mux (SHA vs SDRAM) ───────────────────────────────────────────
-  sha_range  <= '1' when xbus_adr(31 downto 20) = x"F10" else '0';
+  -- ── XBUS mux (SHA / ASMI / REMOTE / SDRAM) ────────────────────────────
+  sha_range    <= '1' when xbus_adr(31 downto 20) = x"F10" else '0';
+  asmi_range   <= '1' when xbus_adr(31 downto 20) = x"F20" else '0';
+  remote_range <= '1' when xbus_adr(31 downto 20) = x"F30" else '0';
+  periph_range <= sha_range or asmi_range or remote_range;
+
   sha_stb    <= xbus_stb and sha_range;
-  sdram_stb  <= xbus_stb and (not sha_range);
-  xbus_ack   <= sha_ack or sdram_ack;
-  xbus_err   <= sha_err or sdram_err;
-  xbus_dat_i <= sha_dat when sha_ack = '1' else sdram_dat;
+  asmi_stb   <= xbus_stb and asmi_range;
+  remote_stb <= xbus_stb and remote_range;
+  sdram_stb  <= xbus_stb and (not periph_range);
+
+  xbus_ack   <= sha_ack or asmi_ack or remote_ack or sdram_ack;
+  xbus_err   <= sha_err or asmi_err or remote_err or sdram_err;
+  xbus_dat_i <= sha_dat    when sha_ack    = '1' else
+                asmi_dat   when asmi_ack   = '1' else
+                remote_dat when remote_ack = '1' else
+                sdram_dat;
 
   wb_sha256_inst: wb_sha256
   port map (
@@ -263,6 +320,36 @@ begin
     xbus_err   => sha_err
   );
 
+  wb_altasmi_inst: wb_altasmi_parallel
+  port map (
+    clk        => CLOCK,
+    rst_n      => rstn_int,
+    xbus_adr   => xbus_adr,
+    xbus_dat_w => xbus_dat_o,
+    xbus_sel   => xbus_sel,
+    xbus_we    => xbus_we,
+    xbus_stb   => asmi_stb,
+    xbus_cyc   => xbus_cyc,
+    xbus_dat_r => asmi_dat,
+    xbus_ack   => asmi_ack,
+    xbus_err   => asmi_err
+  );
+
+  wb_altremote_inst: wb_altremote_update
+  port map (
+    clk        => CLOCK,
+    rst_n      => rstn_int,
+    xbus_adr   => xbus_adr,
+    xbus_dat_w => xbus_dat_o,
+    xbus_sel   => xbus_sel,
+    xbus_we    => xbus_we,
+    xbus_stb   => remote_stb,
+    xbus_cyc   => xbus_cyc,
+    xbus_dat_r => remote_dat,
+    xbus_ack   => remote_ack,
+    xbus_err   => remote_err
+  );
+
   wb_sdram_inst: wb_sdram_ctrl
   port map (
     clk        => CLOCK,
