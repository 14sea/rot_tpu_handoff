+// wb_altasmi_parallel.v — thin Wishbone (NEORV32 XBUS) wrapper around the
+// Altera altasmi_parallel megafunction.  Drives the dedicated AS pins
+// (DCLK / nCSO / ASDO / DATA0) via USE_ASMIBLOCK=ON — no QSF pin
+// assignments needed.
+//
+// Base: 0xF2000000.  1 MB decode window (xbus_adr[31:20] == 12'hF20).
+//
+// "Thin" model: MMIO exposes altasmi's raw control inputs and outputs;
+// firmware (Phase 3 epcs.c) drives the per-byte handshake.  Bits in CTRL
+// are split into LEVEL (read/write/sec_erase/rd_status — held until
+// firmware clears) and PULSE (shift_bytes/wren/reset — auto-clear after
+// one cycle).
+//
+// Register map (byte offsets, 32-bit accesses):
+//   0x00  CTRL    (W)  b0=read    (level)
+//                      b1=write   (level)
+//                      b2=sector_erase (level)
+//                      b3=read_status  (level)
+//                      b4=shift_bytes  (1-cycle pulse)
+//                      b5=wren         (1-cycle pulse)
+//                      b6=reset        (1-cycle pulse; clears sticky flags)
+//                  (R)  reads back the 4 level bits in same positions
+//   0x04  ADDR    (R/W) [23:0]   altasmi.addr
+//   0x08  DATAIN  (R/W) [7:0]    altasmi.datain
+//   0x0C  STATUS  (R)   b0=busy
+//                       b1=data_valid_sticky (clears on DATAOUT read or reset)
+//                       b2=illegal_erase_sticky (clears on reset)
+//                       b3=illegal_write_sticky (clears on reset)
+//   0x10  DATAOUT (R)   [7:0]    latched altasmi.dataout (reading clears DV)
+//   0x14  ESTAT   (R)   [7:0]    altasmi.status_out (latest read_status result)
+
+module wb_altasmi_parallel (
+    input         clk,
+    input         rst_n,
+
+    input  [31:0] xbus_adr,
+    input  [31:0] xbus_dat_w,
+    input  [3:0]  xbus_sel,
+    input         xbus_we,
+    input         xbus_stb,
+    input         xbus_cyc,
+    output reg [31:0] xbus_dat_r,
+    output reg    xbus_ack,
+    output        xbus_err
+);
+    assign xbus_err = 1'b0;
+
+    wire in_range = (xbus_adr[31:20] == 12'hF20);
+    wire [7:0] off = xbus_adr[7:0];
+
+    // ── Control registers ─────────────────────────────────────────────
+    reg ctrl_read;
+    reg ctrl_write;
+    reg ctrl_sec_erase;
+    reg ctrl_rd_status;
+    reg ctrl_shift_bytes;
+    reg ctrl_wren;
+    reg ctrl_reset;
+    reg [23:0] addr_reg;
+    reg [7:0]  datain_reg;
+
+    // ── altasmi outputs ───────────────────────────────────────────────
+    wire        am_busy;
+    wire        am_data_valid;
+    wire [7:0]  am_dataout;
+    wire [7:0]  am_status_out;
+    wire        am_illegal_erase;
+    wire        am_illegal_write;
+
+    // Generated by qmegawiz from rtl/ip/epcs_ctrl.v (altasmi_parallel
+    // wrapper, EPCS16, Cyclone IV E, USE_ASMIBLOCK=ON — drives the
+    // dedicated AS pins DCLK/nCSO/ASDO/DATA0 automatically).
+    epcs_ctrl u_am (
+        .clkin         (clk),
+        .reset         (ctrl_reset),
+        .addr          (addr_reg),
+        .datain        (datain_reg),
+        .rden          (1'b1),
+        .read          (ctrl_read),
+        .write         (ctrl_write),
+        .sector_erase  (ctrl_sec_erase),
+        .read_status   (ctrl_rd_status),
+        .shift_bytes   (ctrl_shift_bytes),
+        .wren          (ctrl_wren),
+        .busy          (am_busy),
+        .data_valid    (am_data_valid),
+        .dataout       (am_dataout),
+        .status_out    (am_status_out),
+        .illegal_erase (am_illegal_erase),
+        .illegal_write (am_illegal_write),
+        .read_address  ()  // diagnostic-only; not surfaced over MMIO
+    );
+
+    // ── Sticky flags + dataout latch ──────────────────────────────────
+    reg flag_illegal_erase;
+    reg flag_illegal_write;
+    reg flag_data_valid;
+    reg [7:0] latched_dataout;
+    reg       dataout_read_req;  // pulsed when firmware reads DATAOUT
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            flag_illegal_erase <= 1'b0;
+            flag_illegal_write <= 1'b0;
+            flag_data_valid    <= 1'b0;
+            latched_dataout    <= 8'd0;
+        end else begin
+            if (am_illegal_erase) flag_illegal_erase <= 1'b1;
+            if (am_illegal_write) flag_illegal_write <= 1'b1;
+            if (am_data_valid) begin
+                flag_data_valid <= 1'b1;
+                latched_dataout <= am_dataout;
+            end else if (dataout_read_req) begin
+                flag_data_valid <= 1'b0;
+            end
+            if (ctrl_reset) begin
+                flag_illegal_erase <= 1'b0;
+                flag_illegal_write <= 1'b0;
+                flag_data_valid    <= 1'b0;
+            end
+        end
+    end
+
+    // ── Bus transaction ───────────────────────────────────────────────
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            xbus_ack         <= 1'b0;
+            xbus_dat_r       <= 32'd0;
+            ctrl_read        <= 1'b0;
+            ctrl_write       <= 1'b0;
+            ctrl_sec_erase   <= 1'b0;
+            ctrl_rd_status   <= 1'b0;
+            ctrl_shift_bytes <= 1'b0;
+            ctrl_wren        <= 1'b0;
+            ctrl_reset       <= 1'b0;
+            addr_reg         <= 24'd0;
+            datain_reg       <= 8'd0;
+            dataout_read_req <= 1'b0;
+        end else begin
+            xbus_ack         <= 1'b0;
+            // auto-clear pulse bits + read-req strobe
+            ctrl_shift_bytes <= 1'b0;
+            ctrl_wren        <= 1'b0;
+            ctrl_reset       <= 1'b0;
+            dataout_read_req <= 1'b0;
+
+            if (xbus_cyc && xbus_stb && in_range && !xbus_ack) begin
+                xbus_ack <= 1'b1;
+                if (xbus_we) begin
+                    case (off)
+                        8'h00: begin
+                            ctrl_read        <= xbus_dat_w[0];
+                            ctrl_write       <= xbus_dat_w[1];
+                            ctrl_sec_erase   <= xbus_dat_w[2];
+                            ctrl_rd_status   <= xbus_dat_w[3];
+                            ctrl_shift_bytes <= xbus_dat_w[4];
+                            ctrl_wren        <= xbus_dat_w[5];
+                            ctrl_reset       <= xbus_dat_w[6];
+                        end
+                        8'h04: addr_reg   <= xbus_dat_w[23:0];
+                        8'h08: datain_reg <= xbus_dat_w[7:0];
+                        default: ;
+                    endcase
+                end else begin
+                    case (off)
+                        8'h00: xbus_dat_r <= {28'd0, ctrl_rd_status, ctrl_sec_erase,
+                                              ctrl_write, ctrl_read};
+                        8'h04: xbus_dat_r <= {8'd0, addr_reg};
+                        8'h08: xbus_dat_r <= {24'd0, datain_reg};
+                        8'h0C: xbus_dat_r <= {28'd0, flag_illegal_write, flag_illegal_erase,
+                                              flag_data_valid, am_busy};
+                        8'h10: begin
+                            xbus_dat_r       <= {24'd0, latched_dataout};
+                            dataout_read_req <= 1'b1;
+                        end
+                        8'h14: xbus_dat_r <= {24'd0, am_status_out};
+                        default: xbus_dat_r <= 32'd0;
+                    endcase
+                end
+            end
+        end
+    end
+
+endmodule
