 rtl/wb_altremote_update.v        | 371 +++++++++----------------------
 sw/stage2_loader/main.c          | 100 +++------
 sw/stage2_loader/remote_update.c | 135 +++++++----
 sw/stage2_loader/remote_update.h |  39 ++--
 4 files changed, 261 insertions(+), 384 deletions(-)

diff --git a/rtl/wb_altremote_update.v b/rtl/wb_altremote_update.v
index 33bcc7a..88fbb62 100644
--- a/rtl/wb_altremote_update.v
+++ b/rtl/wb_altremote_update.v
@@ -1,52 +1,63 @@
 // wb_altremote_update.v — Wishbone (NEORV32 XBUS) wrapper around the
-// Cyclone IV E remote-update block (cycloneive_rublock primitive),
-// implementing the 29-bit shift-register handshake described in the
-// Cyclone IV Device Handbook (Vol 1, Ch 8 "Remote System Upgrade").
+// Cyclone IV E remote-update megafunction (altremote_update IP).
 //
-// We bypass the altremote_update megafunction entirely — its Lite-
-// Edition qmegawiz silent generator strips write_param/data_in for
-// Cyclone IV E in REMOTE mode, leaving no way to set PGM_SEL from the
-// running image.  The underlying rublock primitive supports the full
-// (write + read + reconfig) interface; we drive it directly with a
-// small shift FSM.
+// 2026-05-20 REWRITE: switched from direct cycloneive_rublock primitive
+// to megafunction.  Prior wrapper bypassed the megafunction because we
+// thought 21.1 Lite's qmegawiz silent generator strips write_param/data_in
+// — re-tested 2026-05-20 by elaborating altremote_update directly via
+// Verilog-instantiation path through quartus_map, which auto-generates a
+// fully-functional `rmtupdt_ik21` containing all the field decoders, the
+// rublock_clock divider (`! (clock | idle_write_wait)`), and the correct
+// param/data_in interface.  The "Lite strips" hypothesis is REFUTED.
 //
-// 29-bit shift-register layout (LSB-first per Cyclone IV handbook):
-//   bits  0..23 = boot byte address (PGM_SEL[23:0])
-//   bit      24 = WD_EN  (watchdog enable; 0 = disabled)
-//   bits 25..27 = WD_TMR[2:0] (watchdog timeout selector — ignored when WD_EN=0)
-//   bit      28 = AP_CONFIG_SEL (0 = factory boot next, 1 = application)
-// Firmware writes the full 29-bit value to DATA before kicking SHIFT.
-// For Phase 2 bring-up we hard-disable the watchdog (bit 24 = 0).
+// Why switch: 5 sessions of direct-primitive layout debugging failed —
+// every 29-bit payload encoding (byte / word / Arria-LSB-AnF / no-AnF)
+// caused chip fall-back to factory.  Empirical: 4 layout hypotheses
+// tested via mode X parametric reconfig on 2026-05-20, all returned to
+// page-0 RoT.  Inferred either chip primitive's actual layout is more
+// complex than 29 flat bits OR the wrapper's 50 MHz clocking violates
+// the primitive's timing.  The megafunction handles both correctly.
+//
+// IP parameters (matches our 24-bit EPCS / Cyclone IV E):
+//   config_device_addr_width = 24     (24-bit byte address)
+//   in_data_width            = 24
+//   out_data_width           = 29
+//   operation_mode           = "REMOTE"
+//   is_epcq                  = "false"  (EPCS, not EPCQ)
+//   support_write_check      = "1"     (need write_param/data_in)
+//   intended_device_family   = "Cyclone IV E"
 //
 // Base: 0xF3000000.  1 MB decode (xbus_adr[31:20] == 12'hF30).
 //
 // Register map (byte offsets, 32-bit accesses):
-//   0x00  DATA    (R/W)  [28:0] shift-register payload
-//                  Reading after SHIFT_OUT_CAPTURE returns the captured
-//                  rublock state.
-//   0x04  CMD     (W)
-//                  b0 = SHIFT_IN_AND_RECONFIG : load DATA, shift it
-//                       into rublock (29 cycles), pulse rconfig — FPGA
-//                       reloads from the new boot page (~150 ms).
-//                  b1 = SHIFT_OUT_CAPTURE     : capture current rublock
-//                       state, shift 29 bits into DATA over 29 cycles.
-//                  b2 = RECONFIG_ONLY         : pulse rconfig using
-//                       whatever rublock currently holds (post-POR
-//                       this is the factory image — useful for testing).
-//                  b3 = RESET_TIMER           : pulse rsttimer
-//                       (watchdog clear; cheap when WD_EN=0).
-//                  b4 = SHIFT_IN_ONLY         : load DATA, shift it
-//                       into rublock (29 cycles), but DO NOT pulse
-//                       rconfig.  Diagnostic to verify the rublock
-//                       register retains writes — pair with
-//                       SHIFT_OUT_CAPTURE to read back.
-//                  CMD writes are level-edge: any high bit triggers
-//                  the corresponding action.  STATUS.busy gates new
-//                  triggers.
-//   0x08  STATUS  (R)
-//                  b0 = busy (FSM running)
-//                  b1 = done_sticky (last op completed; clears on read)
-//                  b4..0 = state[3:0] (debug)
+//   0x00  DATA    (R/W) write side: data_in[23:0] for next write_param
+//                       read side : data_out[28:0] from last read_param
+//   0x04  CTRL    (W)   packed control word; writing triggers actions:
+//                       [2:0]  = param[2:0] (field selector)
+//                       [3]    = pulse write_param this cycle
+//                       [4]    = pulse read_param this cycle
+//                       [5]    = pulse reset_timer this cycle
+//                       [6]    = pulse reconfig this cycle (POINT OF NO RETURN)
+//                       [9:8]  = read_source[1:0] (for read_param)
+//                       Pulses are gated by !busy.
+//   0x08  STATUS  (R)   [0] = busy (from megafunction)
+//
+// Param values (Cyclone IV / Cyclone 10 LP per Intel docs + ALSE app note):
+//   3'b100 = Page Select   (24-bit byte address; chip uses high 22 bits)
+//   3'b011 = Watchdog Enable (data_in[0])
+//   3'b010 = Watchdog Timeout (12 bits)
+//   3'b001 = Early ConfDone Check / Cd_early (data_in[0])
+//   3'b111 = Read reconfig source (use with read_source=01)
+//
+// Firmware sequence to boot application slot 1 (byte 0x80000):
+//   1. wait busy=0
+//   2. DATA = 0x80000;                  CTRL = (100 << 0) | (1 << 3)  // write page
+//   3. wait busy=0
+//   4. DATA = 0x000000;                 CTRL = (011 << 0) | (1 << 3)  // WD disable
+//   5. wait busy=0
+//   6. DATA = 0x000001;                 CTRL = (001 << 0) | (1 << 3)  // Cd_early
+//   7. wait busy=0
+//   8. CTRL = (1 << 6)                                                 // reconfig
 
 module wb_altremote_update (
     input         clk,
@@ -67,244 +78,82 @@ module wb_altremote_update (
     wire in_range = (xbus_adr[31:20] == 12'hF30);
     wire [7:0] off = xbus_adr[7:0];
 
-    // ── rublock primitive I/O ─────────────────────────────────────────
-    reg  ru_shiftnld;  // 1 = shift, 0 = load/update
-    reg  ru_captnupdt; // 1 = capture (read), 0 = update (write)
-    reg  ru_regin;     // serial in
-    reg  ru_rsttimer;  // watchdog clear
-    reg  ru_rconfig;   // pulse → FPGA reloads
-    wire ru_regout;    // serial out
-
-    cycloneive_rublock u_ru (
-        .clk       (clk),
-        .shiftnld  (ru_shiftnld),
-        .captnupdt (ru_captnupdt),
-        .regin     (ru_regin),
-        .rsttimer  (ru_rsttimer),
-        .rconfig   (ru_rconfig),
-        .regout    (ru_regout)
+    // ── Megafunction signals ──────────────────────────────────────────
+    reg  [23:0] data_in;
+    wire [28:0] data_out;
+    reg  [2:0]  param;
+    reg  [1:0]  read_source;
+    reg         write_param;
+    reg         read_param;
+    reg         reconfig;
+    reg         reset_timer;
+    wire        busy;
+
+    altremote_update #(
+        .config_device_addr_width(24),
+        .in_data_width(24),
+        .out_data_width(29),
+        .operation_mode("REMOTE"),
+        .lpm_type("altremote_update"),
+        .support_write_check("1"),
+        .check_app_pof("false"),
+        .is_epcq("false"),
+        .intended_device_family("Cyclone IV E")
+    ) u_ru (
+        .clock(clk),
+        .reset(~rst_n),
+        .reconfig(reconfig),
+        .reset_timer(reset_timer),
+        .write_param(write_param),
+        .read_param(read_param),
+        .param(param),
+        .data_in(data_in),
+        .read_source(read_source),
+        .data_out(data_out),
+        .busy(busy)
     );
 
-    // ── User register: 29-bit shift payload (write side) ────────────
-    reg [28:0] data_reg;
-    // FSM-owned readback register: holds shift-out capture result.
-    // Reading DATA returns this so the FSM and bus block don't both
-    // drive the same net (avoids Quartus error 10028).
-    reg [28:0] capture_reg;
-
-    // ── FSM ──────────────────────────────────────────────────────────
-    localparam S_IDLE       = 4'd0;
-    localparam S_LOAD_PRE   = 4'd1;  // capt=0, shiftnld=0 for one clk (latch in)
-    localparam S_SHIFT_IN   = 4'd2;  // shiftnld=1, regin = data_reg LSB, 29 cycles
-    localparam S_LOAD_POST  = 4'd3;  // shiftnld=0 for one clk (update PGM_SEL)
-    localparam S_RECONFIG   = 4'd4;  // rconfig=1 for one clk (point of no return)
-    localparam S_CAP_PRE    = 4'd5;  // capt=1, shiftnld=0 for one clk (capture)
-    localparam S_SHIFT_OUT  = 4'd6;  // capt=1, shiftnld=1, shift 29 cycles
-    localparam S_TIMER_RST  = 4'd7;  // rsttimer=1 for one clk
-    localparam S_DONE       = 4'd8;
-
-    reg [3:0]  state;
-    reg [4:0]  bit_cnt;       // 0..28 (need 5 bits for value 29)
-    reg [28:0] shift_buf;     // local shift register (mirror)
-    reg        done_sticky;
-    reg        status_read_req;
-
-    wire busy = (state != S_IDLE) && (state != S_DONE);
-
-    // Trigger latches (so single MMIO write into CMD can start one op)
-    reg trig_shift_in;
-    reg trig_shift_out;
-    reg trig_reconfig;
-    reg trig_rsttimer;
-    reg trig_shift_in_only;  /* 2026-05-19 diagnostic */
-
-    // NH12 (2026-05-17 silicon): the bus block clears trig_* one cycle
-    // after CMD write, but S_LOAD_POST reads them ~31 cycles later — so
-    // SHIFT_IN_AND_RECONFIG never actually pulsed rconfig.  This flop
-    // latches the "auto-fire reconfig after shift" intent at S_IDLE
-    // entry so it survives the SHIFT_IN window.
-    reg auto_reconfig;
-
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            state           <= S_IDLE;
-            bit_cnt         <= 5'd0;
-            shift_buf       <= 29'd0;
-            capture_reg     <= 29'd0;
-            done_sticky     <= 1'b0;
-            auto_reconfig   <= 1'b0;
-            ru_shiftnld     <= 1'b0;
-            ru_captnupdt    <= 1'b0;
-            ru_regin        <= 1'b0;
-            ru_rsttimer     <= 1'b0;
-            ru_rconfig      <= 1'b0;
-        end else begin
-            // defaults each cycle
-            ru_shiftnld  <= 1'b0;
-            ru_captnupdt <= 1'b0;
-            ru_regin     <= 1'b0;
-            ru_rsttimer  <= 1'b0;
-            ru_rconfig   <= 1'b0;
-
-            // clear done on STATUS read
-            if (status_read_req) done_sticky <= 1'b0;
-
-            case (state)
-                S_IDLE: begin
-                    bit_cnt <= 5'd0;
-                    if (trig_shift_in) begin
-                        shift_buf     <= data_reg;
-                        // NH12: latch the "fire reconfig after shift" intent.
-                        // CMD.b0 alone is documented as SHIFT_IN_AND_RECONFIG,
-                        // so this is unconditional in the shift_in branch.
-                        auto_reconfig <= 1'b1;
-                        state         <= S_LOAD_PRE;
-                    end else if (trig_shift_in_only) begin
-                        /* 2026-05-19 diagnostic: shift in but don't reconfig. */
-                        shift_buf     <= data_reg;
-                        auto_reconfig <= 1'b0;
-                        state         <= S_LOAD_PRE;
-                    end else if (trig_shift_out) begin
-                        state <= S_CAP_PRE;
-                    end else if (trig_reconfig) begin
-                        auto_reconfig <= 1'b0;
-                        state <= S_RECONFIG;
-                    end else if (trig_rsttimer) begin
-                        state <= S_TIMER_RST;
-                    end
-                end
-
-                S_LOAD_PRE: begin
-                    // one cycle of shiftnld=0, capt=0 → prepare write
-                    ru_shiftnld  <= 1'b0;
-                    ru_captnupdt <= 1'b0;
-                    state <= S_SHIFT_IN;
-                end
-
-                S_SHIFT_IN: begin
-                    ru_shiftnld  <= 1'b1;
-                    ru_captnupdt <= 1'b0;
-                    ru_regin     <= shift_buf[0];
-                    shift_buf    <= {1'b0, shift_buf[28:1]};
-                    if (bit_cnt == 5'd28) begin
-                        bit_cnt <= 5'd0;
-                        state   <= S_LOAD_POST;
-                    end else begin
-                        bit_cnt <= bit_cnt + 5'd1;
-                    end
-                end
-
-                S_LOAD_POST: begin
-                    // shiftnld=0, capt=0 → register loaded into PGM_SEL
-                    ru_shiftnld  <= 1'b0;
-                    ru_captnupdt <= 1'b0;
-                    // NH12: use the latched intent instead of the
-                    // long-since-cleared bus-side trig_* signals.
-                    if (auto_reconfig) begin
-                        auto_reconfig <= 1'b0;
-                        state         <= S_RECONFIG;
-                    end else begin
-                        state <= S_DONE;
-                    end
-                end
-
-                S_RECONFIG: begin
-                    // NH11 (2026-05-17 silicon): the original 1-cycle pulse
-                    // (~20 ns @ 50 MHz) is below the Cyclone IV E rublock
-                    // rconfig min pulse width (~250 ns).  Hold HIGH for 16
-                    // sysclk cycles = 320 ns to clear the spec with margin.
-                    // bit_cnt is already 0 when we enter this state via
-                    // either S_LOAD_POST or S_IDLE (RECONFIG_ONLY path).
-                    ru_rconfig <= 1'b1;
-                    if (bit_cnt == 5'd15) begin
-                        bit_cnt <= 5'd0;
-                        state   <= S_DONE;
-                    end else begin
-                        bit_cnt <= bit_cnt + 5'd1;
-                    end
-                end
-
-                S_CAP_PRE: begin
-                    // capt=1, shiftnld=0 for one clk → snapshot PGM_SEL
-                    ru_shiftnld  <= 1'b0;
-                    ru_captnupdt <= 1'b1;
-                    state <= S_SHIFT_OUT;
-                end
-
-                S_SHIFT_OUT: begin
-                    ru_shiftnld  <= 1'b1;
-                    ru_captnupdt <= 1'b1;
-                    shift_buf <= {ru_regout, shift_buf[28:1]};
-                    if (bit_cnt == 5'd28) begin
-                        bit_cnt     <= 5'd0;
-                        capture_reg <= {ru_regout, shift_buf[28:1]};
-                        state       <= S_DONE;
-                    end else begin
-                        bit_cnt <= bit_cnt + 5'd1;
-                    end
-                end
-
-                S_TIMER_RST: begin
-                    ru_rsttimer <= 1'b1;
-                    state <= S_DONE;
-                end
-
-                S_DONE: begin
-                    done_sticky <= 1'b1;
-                    state       <= S_IDLE;
-                end
-
-                default: state <= S_IDLE;
-            endcase
-        end
-    end
