diff --git a/sw/stage2_loader/crc16.c b/sw/stage2_loader/crc16.c
new file mode 100644
index 0000000..753459a
--- /dev/null
+++ b/sw/stage2_loader/crc16.c
@@ -0,0 +1,50 @@
+/* crc16.c — RBF per-frame CRC port from EP4CE6/fuzz/bitstream.py.
+ * See crc16.h for algorithm constants and Python reference.
+ */
+#include "crc16.h"
+
+uint16_t crc16_rbf_frame(const uint8_t *data) {
+    uint16_t crc = CRC_INIT;
+    for (uint32_t i = 0; i < CRC_DATA_SIZE; i++) {
+        crc ^= data[i];
+        for (int k = 0; k < 8; k++) {
+            if (crc & 1u) {
+                crc = (crc >> 1) ^ CRC_POLY_REFLECTED;
+            } else {
+                crc >>= 1;
+            }
+        }
+    }
+    return crc;
+}
+
+void lc_patch_rbf_crc(uint8_t *rbf) {
+    for (uint32_t frame = CRC_FIRST_CRAM_FRAME;
+         frame <= CRC_LAST_FRAME; frame++) {
+        uint32_t s = CRC_PREAMBLE + frame * CRC_FRAME_SIZE;
+        uint16_t c = crc16_rbf_frame(rbf + s);
+        rbf[s + CRC_DATA_SIZE]     = (uint8_t)(c & 0xFFu);
+        rbf[s + CRC_DATA_SIZE + 1] = (uint8_t)((c >> 8) & 0xFFu);
+    }
+}
+
+void lc_patch_rbf_crc_frames(uint8_t *rbf, const uint8_t *dirty) {
+    for (uint32_t frame = CRC_FIRST_CRAM_FRAME;
+         frame <= CRC_LAST_FRAME; frame++) {
+        uint32_t idx = frame - CRC_FIRST_CRAM_FRAME;
+        if (!(dirty[idx >> 3] & (1u << (idx & 7u)))) continue;
+        uint32_t s = CRC_PREAMBLE + frame * CRC_FRAME_SIZE;
+        uint16_t c = crc16_rbf_frame(rbf + s);
+        rbf[s + CRC_DATA_SIZE]     = (uint8_t)(c & 0xFFu);
+        rbf[s + CRC_DATA_SIZE + 1] = (uint8_t)((c >> 8) & 0xFFu);
+    }
+}
+
+void lc_mark_dirty(uint8_t *bitmap, uint32_t off) {
+    if (off < CRC_PREAMBLE) return;
+    uint32_t rel = off - CRC_PREAMBLE;
+    uint32_t frame = rel / CRC_FRAME_SIZE;
+    if (frame < CRC_FIRST_CRAM_FRAME || frame > CRC_LAST_FRAME) return;
+    uint32_t idx = frame - CRC_FIRST_CRAM_FRAME;
+    bitmap[idx >> 3] |= (uint8_t)(1u << (idx & 7u));
+}
diff --git a/sw/stage2_loader/crc16.h b/sw/stage2_loader/crc16.h
new file mode 100644
index 0000000..caaca79
--- /dev/null
+++ b/sw/stage2_loader/crc16.h
@@ -0,0 +1,48 @@
+/* crc16.h — RBF frame CRC port from EP4CE6/fuzz/bitstream.py.
+ *
+ * Cyclone IV RBFs are CRC-validated per 210-byte frame: 208 data bytes
+ * followed by a 16-bit little-endian CRC (low byte at offset +208).
+ * CRAM frames are indices 25..1751 inclusive; frames 0..24 are header
+ * (no CRC).  CRC algorithm: CRC-16/IBM, reflected, poly 0x8005 (in
+ * reflected form 0xA001), init 0xFE54.
+ *
+ * lc_patch_rbf_crc() walks all 1727 CRAM frames and rewrites every CRC.
+ * lc_patch_rbf_crc_frames() only touches a caller-supplied dirty-frame
+ * bitmap — used by mode 'g' (Phase 8) to skip frames untouched by edits.
+ *
+ * Frame numbering convention matches Python's: CRC_FIRST_CRAM_FRAME=25,
+ * CRC_LAST_FRAME=1751, CRC_PREAMBLE=32, frame_size=210.
+ */
+#ifndef CRC16_H
+#define CRC16_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define CRC_FRAME_SIZE        210u
+#define CRC_DATA_SIZE         208u
+#define CRC_FIRST_CRAM_FRAME  25u
+#define CRC_LAST_FRAME        1751u
+#define CRC_PREAMBLE          32u
+#define CRC_INIT              0xFE54u
+#define CRC_POLY_REFLECTED    0xA001u
+
+#define CRC_NUM_CRAM_FRAMES   (CRC_LAST_FRAME - CRC_FIRST_CRAM_FRAME + 1u)
+/* Dirty-frame bitmap size in bytes — one bit per CRAM frame. */
+#define CRC_DIRTY_BITMAP_BYTES ((CRC_NUM_CRAM_FRAMES + 7u) / 8u)
+
+/* CRC of a single 208-byte data block. */
+uint16_t crc16_rbf_frame(const uint8_t *data);
+
+/* Recompute CRC for every CRAM frame (25..1751) in `rbf`. */
+void lc_patch_rbf_crc(uint8_t *rbf);
+
+/* Recompute CRC only for CRAM frames marked dirty in `dirty`. Bit i
+ * (where i = frame_idx - CRC_FIRST_CRAM_FRAME) governs frame frame_idx. */
+void lc_patch_rbf_crc_frames(uint8_t *rbf, const uint8_t *dirty);
+
+/* Mark the CRAM frame covering byte offset `off` as dirty in `bitmap`.
+ * Out-of-range offsets (header / postamble) are a no-op. */
+void lc_mark_dirty(uint8_t *bitmap, uint32_t off);
+
+#endif /* CRC16_H */
diff --git a/sw/stage2_loader/lutcodec.c b/sw/stage2_loader/lutcodec.c
new file mode 100644
index 0000000..a1d97e2
--- /dev/null
+++ b/sw/stage2_loader/lutcodec.c
@@ -0,0 +1,128 @@
+/* lutcodec.c — see lutcodec.h.
+ *
+ * Ports the address-formula path of EP4CE6/fuzz/bitstream.py:
+ * LutCodec.from_cram_model + predict_sram + write_tt, restricted to
+ * pin-friendly columns.  The σ⁻¹ permutation per (x,y,n) is read from
+ * the lutcodec_sigma_inv_packed table (auto-generated by
+ * host/gen_lutcodec_data.py); everything else is closed-form.
+ */
+#include "lutcodec.h"
+#include "crc16.h"
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* cram_n_delta(n) — Python port from EP4CE6/fuzz/config.py.  n ∈ {0,2,...,30}. */
+static int32_t cram_n_delta(uint16_t n) {
+    int32_t k = (int32_t)(n / 2);   /* k = 0..15 */
+    int32_t half = k / 8;
+    int32_t kh = k % 8;
+    return -(half * 38) - (kh / 2) * 8 - (kh % 2) * 2;
+}
+
+/* cram_ctrl_bit(y) — Python port from EP4CE6/fuzz/config.py.
+ * The "non-wrapped" bp value; the slot-1 wrap path overrides this. */
+static uint8_t cram_ctrl_bit(uint16_t y) {
+    int32_t cram_row = (int32_t)y - 2;
+    int32_t slot = cram_row % 3;
+    int32_t group = cram_row / 3;
+    return (uint8_t)(7 - group - (slot > 0 ? 1 : 0));
+}
+
+static int find_index(const uint16_t *tbl, int n, uint16_t v) {
+    for (int i = 0; i < n; i++) if (tbl[i] == v) return i;
+    return -1;
+}
+
+lc_status_t lc_init(lut_codec_t *lc, uint16_t x, uint16_t y, uint16_t n) {
+    int x_idx = find_index(lutcodec_pin_x, LUTCODEC_NUM_X, x);
+    if (x_idx < 0) return LC_ERR_X;
+    int y_idx = find_index(lutcodec_lab_y, LUTCODEC_NUM_Y, y);
+    if (y_idx < 0) return LC_ERR_Y;
+    if (n > 30 || (n & 1u)) return LC_ERR_N;
+    int n_idx = (int)(n / 2);
+
+    int32_t slot = ((int32_t)y - 2) % 3;
+    int32_t group = ((int32_t)y - 2) / 3;
+    int32_t nd = cram_n_delta(n);
+
+    /* Slot-1 wrap logic (from LutCodec.from_cram_model). */
+    uint32_t addr_adj;
+    uint8_t bp;
+    if (slot == 1 && group == 0) {
+        if (24 + nd <= 0) {
+            bp = (uint8_t)(7 - group);
+            addr_adj = 206u;
+        } else {
+            bp = cram_ctrl_bit(y);
+            addr_adj = 0u;
+        }
+    } else if (slot == 1 && (24 + group * 3 + nd) < 0) {
+        bp = (uint8_t)(7 - group);
+        addr_adj = 207u;
+    } else {
+        bp = cram_ctrl_bit(y);
+        addr_adj = 0u;
+    }
+
+    /* period_start = COLUMN_BASE[x] - 136
+     * offset       = SLOT_BASE[slot] + group*3 + (slot==0 && group>0 ? 1 : 0)
+     * base_addr    = period_start + offset + nd + addr_adj
+     *              = cram_ctrl_addr(x,y,0,n) + addr_adj  */
+    uint32_t period_start = lutcodec_column_base[x_idx] - 136u;
+    uint32_t offset = (uint32_t)lutcodec_slot_base[slot]
+                    + (uint32_t)(group * 3)
+                    + ((slot == 0 && group > 0) ? 1u : 0u);
+    /* nd is negative; add as signed. */
+    lc->base_addr = (uint32_t)((int32_t)period_start + (int32_t)offset
+                               + nd + (int32_t)addr_adj);
+
+    /* Unpack σ⁻¹, then invert to σ. */
+    int flat = x_idx * LUTCODEC_NUM_Y * LUTCODEC_NUM_N
+             + y_idx * LUTCODEC_NUM_N + n_idx;
+    uint8_t packed = lutcodec_sigma_inv_packed[flat];
+    uint8_t si[4];
+    si[0] = (packed >> 0) & 3u;
+    si[1] = (packed >> 2) & 3u;
+    si[2] = (packed >> 4) & 3u;
+    si[3] = (packed >> 6) & 3u;
+    /* σ[j] = i  where σ⁻¹[i] = j. */
+    for (int i = 0; i < 4; i++) lc->sigma[si[i]] = (uint8_t)i;
+
+    lc->bp = bp;
+    lc->k_odd = (uint8_t)((n / 2) & 1u);
+    lc->x = x; lc->y = y; lc->n = n;
+    return LC_OK;
+}
+
+void lut_apply_mask(uint8_t *rbf, const lut_codec_t *lc,
+                    uint16_t mask, uint8_t *dirty) {
+    for (uint32_t b = 0; b < 16; b++) {
+        if (!((mask >> b) & 1u)) continue;
+        uint32_t f0 = (b >> lc->sigma[0]) & 1u;
+        uint32_t f1 = (b >> lc->sigma[1]) & 1u;
+        uint32_t f2 = (b >> lc->sigma[2]) & 1u;
+        uint32_t f3 = (b >> lc->sigma[3]) & 1u;
+        uint32_t pair = ((1u - f0) << 2) | ((1u - f1) << 1) | (1u - f2);
+        uint32_t da = f3 ^ (1u - f2);
+        uint32_t delta = lc->k_odd ? (1u - da) : da;
+        uint32_t addr = lc->base_addr + pair * LUTCODEC_PAIR_SPACING + delta;
+        rbf[addr] ^= (uint8_t)(1u << lc->bp);
+        if (dirty) lc_mark_dirty(dirty, addr);
+    }
+}
+
+lc_status_t lut_apply_with_canon(uint8_t *rbf,
+                                 uint16_t x, uint16_t y, uint16_t n,
+                                 uint16_t mask, uint8_t *dirty) {
+    lut_codec_t lc;
+    lc_status_t st = lc_init(&lc, x, y, n);
+    if (st != LC_OK) return st;
+    /* canon-2input asymmetric-mask layer is empirically a no-op at
+     * pin-friendly columns (Quartus emission matches zero-baseline
+     * canon state).  When this port is extended to X∈{3,4,6,7}
+     * (left-edge), apply the appropriate CANON_2INPUT_ABSOLUTE
+     * transition cells here before lut_apply_mask. */
+    lut_apply_mask(rbf, &lc, mask, dirty);
+    return LC_OK;
+}
diff --git a/sw/stage2_loader/lutcodec.h b/sw/stage2_loader/lutcodec.h
new file mode 100644
index 0000000..33d31f0
--- /dev/null
+++ b/sw/stage2_loader/lutcodec.h
@@ -0,0 +1,70 @@
+/* lutcodec.h — On-chip C port of EP4CE6/fuzz/bitstream.py:LutCodec.
+ *
+ * Scope: pin-friendly columns X∈{10,16,22,28} × Y∈LAB_Y_CE6 × even N.
+ * The 1-input canonicalization layer (canon='a' / neg=False / no
+ * 2-input canon) is implicit — Quartus emits these positions with a
+ * deterministic canon state that matches the zero-baseline RBF.
+ *
+ * Track B mode 'g' usage (Phase 8):
+ *
+ *   lut_codec_t lc;
+ *   if (lc_init(&lc, x, y, n) != LC_OK) goto reject;
+ *   lut_apply_mask(rbf, &lc, mask, dirty_bitmap);
+ *   ...repeat per edit...
+ *   lc_patch_rbf_crc_frames(rbf, dirty_bitmap);
+ *
+ * Semantics of lut_apply_mask(rbf, lc, mask, dirty):
+ *   For each set bit b of `mask`, XOR-flip the cell that minterm b
+ *   maps to.  Equivalent to Python LutCodec.write_tt(rbf, mask) when
+ *   rbf is the zero-baseline RBF (mask=0x0000 Quartus output).
+ *   The dirty bitmap (CRC_DIRTY_BITMAP_BYTES bytes) accumulates which
+ *   CRAM frames were touched, for later CRC repair.
+ */
+#ifndef LUTCODEC_H
+#define LUTCODEC_H
+
+#include <stdint.h>
+#include "lutcodec_data.h"
+
+typedef enum {
+    LC_OK = 0,
+    LC_ERR_X = 1,       /* X not in pin-friendly whitelist */
+    LC_ERR_Y = 2,       /* Y not in LAB_Y_CE6 (CE6 fitter whitelist) */
+    LC_ERR_N = 3,       /* N out of range or odd */
+} lc_status_t;
+
+/* Compact LE descriptor.  16 cells in this LE share the same bp; we
+ * store base_addr (the addr-adj-corrected cram_ctrl_addr at pair=0)
+ * + the σ⁻¹ permutation + bp.  lut_apply_mask computes (pair,delta)
+ * per set bit via the σ-derived formula. */
+typedef struct {
+    uint32_t base_addr;   /* cram_ctrl_addr(x,y,0,n) + addr_adj */
+    uint8_t  sigma[4];    /* inverse of σ⁻¹ — used to map bit→(pair,delta) */
+    uint8_t  bp;          /* 0..7 — same for all 16 cells */
+    uint8_t  k_odd;       /* (n/2) & 1 — flips delta */
+    uint16_t x, y, n;     /* echoed for caller diagnostics */
+} lut_codec_t;
+
+lc_status_t lc_init(lut_codec_t *lc, uint16_t x, uint16_t y, uint16_t n);
+
+/* XOR-apply mask to rbf at the 16 cells of this LE; mark touched CRAM
+ * frames in `dirty` (caller-allocated CRC_DIRTY_BITMAP_BYTES).  Pass
+ * NULL for `dirty` to skip dirty-tracking (caller then must call
+ * lc_patch_rbf_crc(rbf) instead of the per-frame variant). */
+void lut_apply_mask(uint8_t *rbf, const lut_codec_t *lc,
+                    uint16_t mask, uint8_t *dirty);
+
+/* One-shot helper: lc_init + lut_apply_mask + (no-op) σ⁻¹
+ * canonicalization layer.  For pin-friendly X∈{10,16,22,28} the
+ * canon-2input asymmetric-mask layer (35-cell transition; plan v2
+ * Pitfall #16) is empirically a no-op at Quartus emission, so this
+ * wrapper is equivalent to lc_init+lut_apply_mask.  Distinct entry
+ * point exists so a future left-edge-X port (X∈{3,4,6,7}) can switch
+ * canon application on per-position without changing the call site
+ * (plan v2 §Phase 7 spec).  Returns lc_status_t — same codes as
+ * lc_init; lut_apply_mask is only invoked when lc_init returned OK. */
