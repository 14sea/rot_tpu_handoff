From ebc269f6107205096fda00f2f86d2ba33dc0dcd7 Mon Sep 17 00:00:00 2001
From: 14sea <wanhuaning@gmail.com>
Date: Sun, 17 May 2026 16:04:10 +0100
Subject: [PATCH 1/2] Phase 3 NH8 v3 (wrapper RTL): firmware-controlled rden
 via CTRL.b7
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Wrapper-RTL portion of NH8 v3 (originally bundled with diagnostic
firmware updates in a single commit; split for clean separation —
wrapper changes belong to the EPCS controller patch chain, the
diagnostic firmware extension belongs as a follow-on to patch 0010).

Adds:
  - CTRL.b7 = ctrl_rden_drop (1-cycle pulse, auto-clear like
              shift_bytes / wren / reset)
  - reg ctrl_rden_drop alongside the other pulse-bit regs, with
    reset-to-0 and auto-clear semantics matching CTRL.b4-b6.
  - wire am_rden = ~ctrl_rden_drop; routed into epcs_ctrl.rden
    (replacing the previous hardwired 1'b1).
  - Register-map header comment updated for CTRL.b7.

History: NH8 v1 (rden = ~dataout_read_req) preserved end_read_reg
at synthesis but never fired it at runtime — see patches 0011-0012
+ docs/captures/diag_baseline_hang.log.  NH8 v2 (rden = 1'b0)
made end_read fire immediately upon do_read, aborting the FSM
before any byte shifted — see docs/captures/diag_nh8v2_rden0_fsm_abort.log
(md5 cd860075).  v3's firmware-pulsed approach is the correct
control point but timing-races the megafunction's internal FSM.

POST-HW TEST REFUTED (2026-05-17 evening, bitstream md5
1787cd8a163aa543788a93b39b654565, trace md5 b33a3230 — see
docs/captures/diag_nh8v3_rden_pulse_noop.log): single-cycle rden=0
pulse from firmware CTRL.b7 does NOT unstick the stage4 deadlock.
By the time firmware can pulse, stage_cntr has drifted past 2'b10
so end_read_byte=0 → end_read_reg cannot fire even with ~rden=1.
Wrapper-only fixes cannot break this — the FSM doesn't expose
enough state to firmware to catch the 2'b10 window externally.

Patch retained as INFRASTRUCTURE for next session: the CTRL.b7 +
ctrl_rden_drop control point is correct; the megafunction just
needs a regen (port_fast_read=PORT_USED) or a hand-written SPI
master that exposes a workable FSM this CTRL bit can drive.

Resource cost: +1 logic register (ctrl_rden_drop).  No timing
impact (single-cycle pulse, same path as shift_bytes/wren/reset).

Companion patch: 0014 (NH8 v3 diag firmware extension — adds
B5b/B5c steps to mode_epcs_probe).  Apply 0013 + 0014 together
for the full NH8 v3 test surface; 0013 alone gives the wrapper
infrastructure usable by future production epcs_read() updates.
---
 rtl/wb_altasmi_parallel.v | 32 +++++++++++++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/rtl/wb_altasmi_parallel.v b/rtl/wb_altasmi_parallel.v
index 59a8834..026e0ae 100644
--- a/rtl/wb_altasmi_parallel.v
+++ b/rtl/wb_altasmi_parallel.v
@@ -19,6 +19,10 @@
 //                      b4=shift_bytes  (1-cycle pulse)
 //                      b5=wren         (1-cycle pulse)
 //                      b6=reset        (1-cycle pulse; clears sticky flags)
+//                      b7=rden_drop    (1-cycle pulse; drops rden to 0 for
+//                                        one cycle to fire end_read_reg —
+//                                        firmware pulses after last byte
+//                                        of a read to terminate operation)
 //                  (R)  reads back the 4 level bits in same positions
 //   0x04  ADDR    (R/W) [23:0]   altasmi.addr
 //   0x08  DATAIN  (R/W) [7:0]    altasmi.datain
@@ -61,6 +65,7 @@ module wb_altasmi_parallel (
     reg ctrl_shift_bytes;
     reg ctrl_wren;
     reg ctrl_reset;
+    reg ctrl_rden_drop;
     reg [23:0] addr_reg;
     reg [7:0]  datain_reg;
 
@@ -98,12 +103,34 @@ module wb_altasmi_parallel (
     // Generated by qmegawiz from rtl/ip/epcs_ctrl.v (altasmi_parallel
     // wrapper, EPCS16, Cyclone IV E, USE_ASMIBLOCK=ON — drives the
     // dedicated AS pins DCLK/nCSO/ASDO/DATA0 automatically).
+    // NH8 v3: firmware-controlled rden via CTRL.b7 pulse.
+    //
+    // History: NH8 v1 (rden=~dataout_read_req) preserved end_read_reg
+    // at synthesis but never fired it at runtime — the rden-drop
+    // window misaligned with data_valid_wire pulses.  NH8 v2 (rden=0)
+    // fired end_read_reg too aggressively — FSM aborted before
+    // shifting any data byte.  Trace evidence: B1 STATUS=0x00 right
+    // after CTRL=READ (busy never even asserted; the operation
+    // exited immediately).
+    //
+    // Correct semantics: hold rden=1 while bytes are being shifted,
+    // drop rden=0 for one cycle AFTER the final byte's data_valid
+    // pulse to signal "this was the last byte → terminate read."
+    //
+    // Default am_rden=1 (matches original behavior except now
+    // controllable).  Firmware pulses CTRL.b7=1 to drop rden for one
+    // cycle after consuming the last DATAOUT byte:
+    //   *CTRL = CTRL_READ | CTRL_RDEN_DROP;  // rden drops, end_read fires
+    //   wait_not_busy();                      // FSM completes
+    //   *CTRL = 0;                            // deassert READ
+    wire am_rden = ~ctrl_rden_drop;
+
     epcs_ctrl u_am (
         .clkin         (clk),
         .reset         (am_reset_in),
         .addr          (addr_reg),
         .datain        (datain_reg),
-        .rden          (1'b1),
+        .rden          (am_rden),
         .read          (ctrl_read),
         .write         (ctrl_write),
         .sector_erase  (ctrl_sec_erase),
@@ -161,6 +188,7 @@ module wb_altasmi_parallel (
             ctrl_shift_bytes <= 1'b0;
             ctrl_wren        <= 1'b0;
             ctrl_reset       <= 1'b0;
+            ctrl_rden_drop   <= 1'b0;
             addr_reg         <= 24'd0;
             datain_reg       <= 8'd0;
             dataout_read_req <= 1'b0;
@@ -170,6 +198,7 @@ module wb_altasmi_parallel (
             ctrl_shift_bytes <= 1'b0;
             ctrl_wren        <= 1'b0;
             ctrl_reset       <= 1'b0;
+            ctrl_rden_drop   <= 1'b0;
             dataout_read_req <= 1'b0;
 
             if (xbus_cyc && xbus_stb && in_range && !xbus_ack) begin
@@ -184,6 +213,7 @@ module wb_altasmi_parallel (
                             ctrl_shift_bytes <= xbus_dat_w[4];
                             ctrl_wren        <= xbus_dat_w[5];
                             ctrl_reset       <= xbus_dat_w[6];
+                            ctrl_rden_drop   <= xbus_dat_w[7];
                         end
                         8'h04: addr_reg   <= xbus_dat_w[23:0];
                         8'h08: datain_reg <= xbus_dat_w[7:0];
