+#!/usr/bin/env python3
+"""
+gen_edits_h.py — Emit a Plan C-1 v5 mode 'H' edits.bin file.
+
+Same wire format as host/gen_edits.py (Phase 8 edits header + records;
+struct.pack '<IIII' header + '<HHHH' per record).  Difference: a
+**symmetric-mask safety lock** rejects any record whose mask is not
+0x0000 or 0xFFFF.
+
+Why the lock exists:
+
+    Mode H performs σ⁻¹ XOR surgery on the page-0 .rbf in SDRAM and
+    programs the result to EPCS slot 1.  For non-symmetric masks the
+    H1 vs H2 question (does Cyclone IV LE read only the 16 LUT data
+    cells at runtime, or also canon-cells?) is unresolved on this
+    toolchain — Quartus 21.1 Lite silently drops LCCOMB
+    location_assignments, so the original M0-M4 in-iron sentinel
+    validation cannot run.  Empirical trail in
+    [[feedback-quartus-lite-no-lccomb-lock]].
+
+    For symmetric masks {0x0000, 0xFFFF} the codec correctness is
+    implicitly validated by existing mode g/G silicon evidence: σ
+    permutes identical cells, so the H1/H2 distinction collapses.
+
+    The on-chip mode_fabric_surgery handler enforces the same
+    symmetric-mask check; this host tool is the first line of defense
+    so the SD card never carries records the iron would refuse.
+
+Re-opening asymmetric scope requires one of: Quartus Pro/Standard
+(LCCOMB locks honored), a working post-fit placement-query mechanism
+in Lite (none found at the time of writing), or a Path-D alternative
+test (mode g writes asymmetric mask at an existing pin-friendly LE,
+observed via UART/XBUS).  Until then, use gen_edits.py for mode g/G
+exploration (those write to TPU LUT memory, not fabric).
+
+Input modes / output: same as gen_edits.py.
+"""
+import argparse
+import json
+import os
+import sys
+
+# Reuse pack_edits + whitelist machinery from the general edits-bin
+# generator.  Keeping the format in one place; this file only narrows
+# the mask domain.
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from gen_edits import pack_edits, parse_edits, _parse_mask  # noqa: E402
+
+
+MODE_H_SYMMETRIC_MASKS = (0x0000, 0xFFFF)
+
+
+def _check_symmetric(mask, where):
+    if mask not in MODE_H_SYMMETRIC_MASKS:
+        allowed = ", ".join(f"0x{m:04X}" for m in MODE_H_SYMMETRIC_MASKS)
+        raise SystemExit(
+            f"[gen_edits_h] {where}: mask=0x{mask:04X} is not symmetric.\n"
+            f"  Mode H first-ship accepts only {{{allowed}}}.\n"
+            f"  Asymmetric masks are gated until the Quartus Lite LCCOMB-\n"
+            f"  lock toolchain blocker is resolved — see\n"
+            f"  [[feedback-quartus-lite-no-lccomb-lock]] in memory.\n"
+            f"  For mode g/G (TPU LUT memory loader, no fabric edit)\n"
+            f"  use host/gen_edits.py instead — that has no mask\n"
+            f"  restriction.")
+
+
+def main():
+    ap = argparse.ArgumentParser(
+        description=__doc__,
+        formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--json", help="JSON manifest path (list of {x,y,n,mask})")
+    ap.add_argument("--edit", action="append", default=[],
+                    metavar="X,Y,N,M",
+                    help="add one record; repeatable. Mask must be "
+                         "0x0000 or 0xFFFF.")
+    ap.add_argument("--out", default="edits.bin",
+                    help="output path (default: edits.bin)")
+    ap.add_argument("--print", action="store_true",
+                    help="print parsed records after writing (smoke check)")
+    args = ap.parse_args()
+
+    records = []
+    if args.json:
+        with open(args.json) as f:
+            for entry in json.load(f):
+                mask = _parse_mask(entry["mask"])
+                _check_symmetric(mask, f"--json entry x={entry['x']} "
+                                       f"y={entry['y']} n={entry['n']}")
+                records.append((
+                    int(entry["x"]),
+                    int(entry["y"]),
+                    int(entry["n"]),
+                    mask,
+                ))
+    for e in args.edit:
+        parts = e.split(",")
+        if len(parts) != 4:
+            raise SystemExit(f"--edit must be X,Y,N,M (got {e!r})")
+        x, y, n = int(parts[0]), int(parts[1]), int(parts[2])
+        mask = _parse_mask(parts[3])
+        _check_symmetric(mask, f"--edit x={x} y={y} n={n}")
+        records.append((x, y, n, mask))
+
+    if not records:
+        raise SystemExit("no records — pass --json and/or --edit")
+
+    # pack_edits also runs the pin-friendly (X, Y, N) whitelist check
+    # that the on-chip lc_init enforces, so out-of-grid records are
+    # rejected here exactly as the iron would.
+    blob = pack_edits(records)
+    with open(args.out, "wb") as f:
+        f.write(blob)
+    print(f"[gen_edits_h] wrote {args.out} ({len(blob)} B, "
+          f"{len(records)} records, mode H symmetric-mask scope)")
+    if args.print:
+        for i, rec in enumerate(parse_edits(blob)):
+            print(f"  [{i}] x={rec[0]:2d} y={rec[1]:2d} n={rec[2]:2d} "
+                  f"mask=0x{rec[3]:04X}")
+
+
+if __name__ == "__main__":
+    main()
