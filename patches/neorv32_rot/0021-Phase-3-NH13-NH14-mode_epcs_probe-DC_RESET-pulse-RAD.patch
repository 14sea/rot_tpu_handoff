---
 sw/stage2_loader/main.c | 46 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/sw/stage2_loader/main.c b/sw/stage2_loader/main.c
index 76f822a..855bb50 100644
--- a/sw/stage2_loader/main.c
+++ b/sw/stage2_loader/main.c
@@ -293,11 +293,18 @@ static void mode_epcs_probe(void)
     #define DP_STATUS  ((volatile uint32_t *)(DP_BASE + 0x0C))
     #define DP_DATAOUT ((volatile uint32_t *)(DP_BASE + 0x10))
     #define DP_ESTAT   ((volatile uint32_t *)(DP_BASE + 0x14))
+    /* NH14: read_address output of the megafunction (NH7 wired to MMIO).
+     * Probe to distinguish (a) megafunction loads addr per-op vs (b)
+     * read_add_cntr accumulates across ops vs (c) addr never loads at all. */
+    #define DP_RADDR   ((volatile uint32_t *)(DP_BASE + 0x18))
 
     /* CTRL bits (from epcs.c + NH8 v3 wrapper) */
     #define DC_READ        (1u << 0)
     #define DC_RD_STATUS   (1u << 3)
     #define DC_SHIFT_BYTES (1u << 4)
+    #define DC_RESET       (1u << 6)   /* NH13: 1-cycle pulse; wrapper NH13
+                                          stretches to 16 cycles for the
+                                          megafunction ≥250 ns reset spec */
     #define DC_RDEN_DROP   (1u << 7)   /* NH8 v3: drops rden for 1 cycle */
     #define DC_FAST_READ   (1u << 8)   /* NH9: opcode 0x0B + 24-bit addr + 1 dummy byte */
 
@@ -309,6 +316,8 @@ static void mode_epcs_probe(void)
     /* ---- Step P0: STATUS at idle (no CTRL writes yet) ---- */
     uart_puts("[P] s0 idle STATUS=");
     uart_puthex32(*DP_STATUS);
+    uart_puts(" RADDR=");
+    uart_puthex32(*DP_RADDR);
     uart_puts("\r\n");
 
     /* =================================================================
@@ -539,9 +548,24 @@ static void mode_epcs_probe(void)
      * ================================================================= */
     uart_puts("[P] --- Phase C: FAST_READ 4B @0 ---\r\n");
 
+    /* NH13: pulse DC_RESET before each FAST_READ so the megafunction's
+     * internal read_add_cntr starts from addr (instead of accumulating
+     * across operations).  Wrapper stretches this to 16 sysclk cycles
+     * (320 ns) to clear the megafunction's 250 ns reset spec.  Sw delay
+     * ensures stretcher deasserts before the next CTRL=FAST_READ. */
+    *DP_CTRL = DC_RESET;
+    for (volatile int i = 0; i < 32; i++) { /* stretcher delay */ }
+
+    /* NH14: RADDR before ADDR write — is megafunction's counter cleared? */
+    uart_puts("[P] C-pre-addr RADDR=");
+    uart_puthex32(*DP_RADDR);
+    uart_puts("\r\n");
+
     *DP_ADDR = 0x000000u;
     uart_puts("[P] C0 ADDR=0 STATUS=");
     uart_puthex32(*DP_STATUS);
+    uart_puts(" RADDR=");
+    uart_puthex32(*DP_RADDR);
     uart_puts("\r\n");
 
     *DP_CTRL = DC_FAST_READ;
@@ -604,6 +628,8 @@ static void mode_epcs_probe(void)
     *DP_CTRL = 0;
     uart_puts("[P] C5 after CTRL=0 STATUS=");
     uart_puthex32(*DP_STATUS);
+    uart_puts(" RADDR=");
+    uart_puthex32(*DP_RADDR);
     uart_puts("\r\n");
 
     /* Wait for NH10 auto-terminate to fully release busy before any
@@ -647,7 +673,27 @@ static void mode_epcs_probe(void)
     };
     for (uint32_t r = 0; r < 3u; r++) {
         uint32_t a = D_ADDRS[r];
+
+        /* NH13: pulse DC_RESET between iterations (and on the first
+         * iteration) — see Phase C comment for rationale. */
+        *DP_CTRL = DC_RESET;
+        for (volatile int i = 0; i < 32; i++) { /* stretcher delay */ }
+
+        /* NH14: RADDR before+after each ADDR write per D-iter. */
+        uart_puts("[P] D");
+        uart_puthex32(r);
+        uart_puts(" pre-addr RADDR=");
+        uart_puthex32(*DP_RADDR);
+        uart_puts("\r\n");
+
         *DP_ADDR = a;
+
+        uart_puts("[P] D");
+        uart_puthex32(r);
+        uart_puts(" post-addr RADDR=");
+        uart_puthex32(*DP_RADDR);
+        uart_puts("\r\n");
+
         *DP_CTRL = DC_FAST_READ;
 
         for (uint32_t byte_i = 0; byte_i < 4u; byte_i++) {
