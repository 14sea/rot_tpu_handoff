+/* Mode 'b': Load Linux from SD card blob (header @ LBA 0).
+ * Field order MUST match host/sd_layout.py build_header():
+ *   [0..8)   magic
+ *   [8..32)  image_sz, dtb_sz, initrd_sz, image_lba, dtb_lba, initrd_lba
