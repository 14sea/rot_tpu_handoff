 };
 
 static void __attribute__((noreturn)) jump_to_kernel(void)
@@ -487,6 +503,83 @@ static void mode_sd_boot(void)
     jump_to_kernel();
 }
 
+/* Mode 't' (Phase 1 of ROT→TPU EPCS handoff plan):
+ *   1. Read SD header at LBA 0; verify magic + layout_version >= 3.
+ *   2. Read TPU.rbf from h->tpu_lba (368 KB) into TPU_SCRATCH_ADDR.
+ *   3. Hash via wb_sha256 → compare to baked rot_golden_tpu_bitstream.
+ *   4. Halt with [OK] or [MISMATCH] — Phase 1 does NOT touch EPCS.
+ *
+ * This is the trust gate: any TPU.rbf whose SHA-256 doesn't match the
+ * constant baked into ROT's bitstream-resident IMEM is refused before
+ * any EPCS write or ALTREMOTE_UPDATE trigger (Phases 3+4).
+ */
+static void mode_tpu_verify(void)
+{
+    uart_puts("[stage2] Mode: TPU bitstream verify (Phase 1)\r\n");
+
+    extern int sd_init(void);
+    extern int sd_read_block(uint32_t lba, uint8_t *dst);
+    extern int sd_read_many(uint32_t lba, uint32_t n, uint8_t *dst);
+
+    if (sd_init()) { uart_puts("[sd] init FAIL\r\n"); while (1) {} }
+
+    static uint8_t hdr_buf[512];
+    if (sd_read_block(0, hdr_buf)) {
+        uart_puts("[sd] read hdr FAIL\r\n"); while (1) {}
+    }
+
+    /* Verify magic "NEOLNX\0\0" — same gate as mode_sd_boot. */
+    const char magic[8] = { 'N','E','O','L','N','X','\0','\0' };
+    for (int i = 0; i < 8; i++) {
+        if (hdr_buf[i] != (uint8_t)magic[i]) {
+            uart_puts("[sd] bad magic\r\n"); while (1) {}
+        }
+    }
+
+    struct sd_boot_hdr *h = (struct sd_boot_hdr *)hdr_buf;
+    if (h->layout_version < 3) {
+        uart_puts("[!] layout_version="); uart_puthex32(h->layout_version);
+        uart_puts(" < 3 — re-pack SD with sd_pack.py from "
+                  "neorv32_rot v3+ to get TPU slot\r\n");
+        while (1) {}
+    }
+    if (h->tpu_sz == 0) {
+        uart_puts("[!] header tpu_sz=0 — SD packed without --tpu-rbf\r\n");
+        while (1) {}
+    }
+    uart_puts("[sd] tpu_lba="); uart_puthex32(h->tpu_lba);
+    uart_puts(" tpu_sz=");      uart_puthex32(h->tpu_sz);
+    uart_puts("\r\n");
+
+    uint32_t tpu_blks = (h->tpu_sz + 511) / 512;
+    uart_puts("[sd] reading TPU.rbf\r\n");
+    if (sd_read_many(h->tpu_lba, tpu_blks, (uint8_t *)TPU_SCRATCH_ADDR)) {
+        uart_puts("[!] SD read FAIL lba="); uart_puthex32(h->tpu_lba);
+        uart_puts("\r\n"); while (1) {}
+    }
+
+    /* Hash + compare to BAKED golden — same convention as mode_sd_boot.
+     * Hash covers tpu_sz bytes exactly (not the 512-byte-padded slot). */
+    uint32_t H[8];
+    sha256_hw((const void *)(uintptr_t)TPU_SCRATCH_ADDR, h->tpu_sz, H);
+    uart_puts("[rot] TPU sha256=");
+    for (int i = 0; i < 8; i++) uart_puthex32(H[i]);
+    int match = 1;
+    for (int i = 0; i < 8; i++)
+        if (H[i] != rot_golden_tpu_bitstream[i]) { match = 0; break; }
+    if (match) {
+        uart_puts(" [OK]\r\n");
+        uart_puts("[rot] Phase 1 complete — TPU bitstream verified.\r\n");
+        uart_puts("[rot] Phases 2-4 (EPCS write + ALTREMOTE_UPDATE) "
+                  "not implemented yet; halting before any EPCS touch.\r\n");
+    } else {
+        uart_puts(" [MISMATCH] golden=");
+        for (int i = 0; i < 8; i++) uart_puthex32(rot_golden_tpu_bitstream[i]);
+        uart_puts("\r\n[!] TPU SHA mismatch — refusing EPCS write\r\n");
+    }
+    while (1) {}
+}
+
 /* Mode 'l': Load Linux kernel + DTB + initramfs, boot directly */
