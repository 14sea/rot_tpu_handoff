+    uint32_t dtb_max_sec;
+    uint32_t initrd_max_sec;
+    uint32_t tpu_lba;       /* v3: usually 8009 */
+    uint32_t tpu_sz;        /* v3: bytes (368,011 for EP4CE6 RBF) */
