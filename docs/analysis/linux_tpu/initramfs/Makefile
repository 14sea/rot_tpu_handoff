# Build the Linux+TPU demo initramfs (init + /tpu_model.bin + /dev/console).
# Mirrors see_neorv32_run_linux/sw/initramfs/Makefile, adding the model file.
#
# init is a Linux nommu static-PIE userspace binary -> needs a Linux toolchain
# (the bare-metal riscv-none-elf- gcc does NOT support -fpie). Default points at
# the Buildroot one used by see_neorv32_run_linux; override RISCV_LINUX_PREFIX.

RISCV_LINUX_PREFIX ?= /home/test/buildroot/output/host/bin/riscv32-buildroot-linux-gnu-
CC    = $(RISCV_LINUX_PREFIX)gcc
STRIP = $(RISCV_LINUX_PREFIX)strip
HOSTCC = gcc

# Linux source (for usr/gen_init_cpio.c — builds device nodes without root).
LINUX_DIR ?= /home/test/see_neorv32_run_linux/linux-6.6.83

CFLAGS = -nostdlib -nostartfiles -fpie -mcmodel=medany \
         -fno-plt -static -Wl,-pie -Wl,--no-dynamic-linker \
         -Os -fno-stack-protector -fno-builtin \
         -march=rv32imac_zicsr_zifencei -mabi=ilp32

all: neo_initramfs.cpio.gz

# The model file is generated by ../host_reference.py (single source of truth).
tpu_model.bin:
	cd .. && python3 host_reference.py >/dev/null

init: init.c
	$(CC) $(CFLAGS) -o $@ $< -e _start
	$(STRIP) $@

gen_init_cpio: $(LINUX_DIR)/usr/gen_init_cpio.c
	$(HOSTCC) -o $@ $<

neo_initramfs.cpio.gz: init gen_init_cpio tpu_model.bin
	@echo "dir  /dev      0755 0 0"            >  filelist.txt
	@echo "nod  /dev/console 0600 0 0 c 5 1"   >> filelist.txt
	@echo "file /init     init 0755 0 0"       >> filelist.txt
	@echo "file /tpu_model.bin tpu_model.bin 0644 0 0" >> filelist.txt
	./gen_init_cpio filelist.txt | gzip -9 > $@
	@rm -f filelist.txt
	@echo "Built $@ ($$(wc -c < $@) bytes)"

clean:
	rm -rf init gen_init_cpio filelist.txt neo_initramfs.cpio.gz

.PHONY: all clean
